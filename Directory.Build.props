<Project>
  <PropertyGroup>
    <!-- Common build settings for every GameKit csproj -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>CS1591;nullable</WarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Packaging defaults (individual csprojs override PackageId, Description) -->
    <Authors>GameKit contributors</Authors>
    <Company>GameKit contributors</Company>
    <Copyright>Copyright (c) 2026 GameKit contributors</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/OWNER/gamekit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/OWNER/gamekit.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- MinVer config -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>

    <!-- Deterministic builds for reproducibility + SourceLink -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- D-23 + 06-RESEARCH Pitfall 1: expose MinVer's $(Version) to the
         GameKit.Build Roslyn source generator at compile time. Without this,
         AnalyzerConfigOptionsProvider.GlobalOptions cannot read
         build_property.Version and GameKitVersionGenerator emits the
         "0.0.0" fallback stamp — making the OPS-04 release-train assertion
         silently degenerate to a tautology. -->
    <CompilerVisibleProperty Include="Version" />
  </ItemGroup>

  <!-- D-17 + D-26: GameKit.targets contributes an <ItemDefinitionGroup> that
       stamps PackageVersion="[$(Version)]" exact-pin metadata onto every
       ProjectReference at Pack time. Primary defense for the coordinated
       release train; CI grep on produced .nuspec files (Plan 06-08) is the
       layered secondary defense. -->
  <Import Project="$(MSBuildThisFileDirectory)GameKit.targets" />
</Project>
