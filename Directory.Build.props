<Project>
  <PropertyGroup>
    <!-- Common build settings for every GameKit csproj -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>CS1591;nullable</WarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Packaging defaults (individual csprojs override PackageId, Description) -->
    <Authors>GameKit contributors</Authors>
    <Company>GameKit contributors</Company>
    <Copyright>Copyright (c) 2026 GameKit contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/NoahFreelove/gamekit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NoahFreelove/gamekit.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- MinVer config -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>

    <!-- Deterministic builds for reproducibility + SourceLink -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- SEC-07 (Phase 18-01): NuGet supply-chain audit gate.
         Enables vulnerability checking for ALL packages (direct + transitive) and fails
         the build on any HIGH or CRITICAL severity advisory. The prior -p:NuGetAudit=false
         workaround (MEMORY.md "Pre-existing MessagePack NU1903") is now obsolete — the
         underlying advisory (GHSA-hv8m-jj95-wg3x) is eliminated by the MessagePack 3.1.7
         transitive pin in Directory.Packages.props. Do NOT add NuGetAuditSuppress entries
         for MessagePack — the CVE is removed by upgrade, not silenced. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>high</NuGetAuditLevel>

    <!-- D-15 + 06-PATTERNS Critical Misuse Warning #5: emit GameKit.Build
         source-generator output to disk so (a) the Plan 06-01 Task 4 smoke
         verify can grep the live GameKitMarker.GameKitVersion value, and
         (b) Plan 06-08 OPS-04 / OPS-05 integration tests can assert on the
         emitted .g.cs files alongside the compiled IL. Files land at the
         Roslyn default location
         (obj/$(Configuration)/$(TargetFramework)/generated/{GeneratorAssembly}/
         {GeneratorFQN}/) which is excluded from the SDK's default Compile
         glob — overriding CompilerGeneratedFilesOutputPath risks landing
         the file inside the compile glob and producing CS0102 duplicate
         definition errors. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- D-23 + 06-RESEARCH Pitfall 1: expose MinVer's $(Version) to the
         GameKit.Build Roslyn source generator at compile time. Without this,
         AnalyzerConfigOptionsProvider.GlobalOptions cannot read
         build_property.Version and GameKitVersionGenerator emits the
         "0.0.0" fallback stamp — making the OPS-04 release-train assertion
         silently degenerate to a tautology. -->
    <CompilerVisibleProperty Include="Version" />
  </ItemGroup>

  <ItemGroup>
    <!-- OBS-07 / D-07: PII span attribute allow-list wired as AdditionalFiles.
         PiiAttributeAnalyzer reads this file via context.Options.AdditionalFiles
         to exempt explicitly-documented keys from the GK0001 denylist check.
         The absolute-path pattern ensures the file is found regardless of
         which src/ project the analyzer is compiling. -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)src/GameKit.Build/pii-allowlist.txt" />
  </ItemGroup>

  <!-- D-17 + D-26: GameKit.targets contributes an <ItemDefinitionGroup> that
       stamps PackageVersion="[$(Version)]" exact-pin metadata onto every
       ProjectReference at Pack time. Primary defense for the coordinated
       release train; CI grep on produced .nuspec files (Plan 06-08) is the
       layered secondary defense. -->
  <Import Project="$(MSBuildThisFileDirectory)GameKit.targets" />
</Project>
