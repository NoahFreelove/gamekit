<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core + Postgres (verified GA on net10.0 2026-04-15) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.6" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.6" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.6" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.6" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />

    <!-- Redis client (Phase 1 registers but doesn't use heavily) -->
    <PackageVersion Include="StackExchange.Redis" Version="2.8.41" />

    <!-- DI + validation -->
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />

    <!-- Caching (used by IPlayerDisplayNameResolver) -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.6" />

    <!-- Test stack -->
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Testcontainers" Version="4.11.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.11.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.11.0" />
    <PackageVersion Include="Npgsql" Version="10.0.2" />

    <!-- Hosting (used by integration test fixtures for IHost bootstrap) -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />

    <!-- IHttpClientFactory + AddHttpClient extension (Phase 6 Plan 06-08 — used by the
         TicTacToeDuel.GameServer console sample which calls into the web tier over HTTP).
         Pinned at 10.0.6 to match the transitive floor from
         Microsoft.Extensions.Http.Resilience 10.5.0 -> Microsoft.Extensions.Http.Diagnostics 10.5.0
         (CPM downgrade NU1109 fires below 10.0.6). -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.6" />

    <!-- CLI framework (Apache-2.0 — GPL-compatible per FSF 13) -->
    <PackageVersion Include="Spectre.Console.Cli" Version="0.49.1" />

    <!-- Auth stack (Phase 2 — verified GA on net10.0 on 2026-04-18 per 02-RESEARCH.md §4, §8.13) -->
    <!-- NOTE: the Steam contrib OpenID provider is intentionally NOT pinned per D-09            -->
    <!-- (02-CONTEXT.md). GameKit ships an in-house SteamOpenIdVerifier; the contrib package     -->
    <!-- must not be added as a dependency. See .planning/STATE.md Decisions Locked.             -->
    <PackageVersion Include="AspNet.Security.OAuth.Discord" Version="10.0.0" />

    <!-- Phase 7 Auth — Argon2 sibling package (AUTH-17) -->
    <!-- Isopoh.Cryptography.Argon2 2.0.0: CC0, fully managed, 8yr/7M+ downloads — approved.   -->
    <!-- Blake2b + SecureArray are transitive deps; pinned for CPM reproducibility.              -->
    <PackageVersion Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />
    <PackageVersion Include="Isopoh.Cryptography.Blake2b" Version="2.0.0" />
    <PackageVersion Include="Isopoh.Cryptography.SecureArray" Version="2.0.0" />

    <!-- Phase 7 Auth — Google OAuth provider (AUTH-19) -->
    <!-- Microsoft first-party package; 100M+ downloads; net10.0 TFM verified nuget.org.        -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.8" />

    <!-- Phase 7 Auth — Apple Sign-In provider (AUTH-20)                                        -->
    <!-- AspNet.Security.OAuth.Apple 10.0.0: same aspnet-contrib release train as Discord 10.0.0.-->
    <!-- OpenIdConnect 8.14.0 is compatible with JwtBearer 10.0.6 (both use IdentityModel 8.x). -->
    <PackageVersion Include="AspNet.Security.OAuth.Apple" Version="10.0.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.14.0" />
    <PackageVersion Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.6" />
    <!-- Ships _framework/blazor.web.js + blazor.server.js. GameKit.Admin.UI references this
         so the consumer's MapStaticAssets() picks up the framework JS automatically. -->
    <PackageVersion Include="Microsoft.AspNetCore.App.Internal.Assets" Version="10.0.6" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.5.0" />
    <!-- Bumped 8.3.0 → 8.14.0 to resolve NU1109 diamond conflict introduced by             -->
    <!-- Microsoft.IdentityModel.Protocols.OpenIdConnect 8.14.0 (GameKit.Auth.Apple dep).    -->
    <!-- JwtBearer 10.0.6 is compatible with IdentityModel 8.14.0 (both use IdentityModel    -->
    <!-- 8.x under the hood — per 07-RESEARCH §Pitfall 5). Rule 1 auto-fix.                  -->
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.14.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />

    <!-- Auth test stack -->
    <PackageVersion Include="WireMock.Net" Version="2.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />

    <!-- Phase 6 OpenAPI (D-22, 06-RESEARCH §Standard Stack lines 110-113):
         Microsoft.AspNetCore.OpenApi 10.0.8 ships SEPARATELY from the
         Microsoft.AspNetCore.App shared framework (correction to earlier
         CONTEXT.md claim that it lives in shared framework). Verified GA
         on nuget.org 2026-05-12 by 06-RESEARCH Package Legitimacy Audit. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />

    <!-- Phase 11 Lobby — SignalR Redis backplane (runtime dep of GameKit.Lobby).
         Microsoft first-party package; 10.0.8 verified GA on nuget.org 2026-05-12
         (11-RESEARCH §Standard Stack). Reuses existing IConnectionMultiplexer Singleton. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.8" />

    <!-- Phase 11 Lobby — SignalR test client (test-only; used by HubConnectionBuilder
         in GameKit.Lobby.Integration.Tests Wave 2+ backplane + hub-auth tests).
         Microsoft first-party package; same 10.0.8 release train as StackExchangeRedis. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.8" />

    <!-- Phase 3 Admin UI — MudBlazor 9.3.0 verified GA on net10.0 2026-04-18 (MIT / GPL-compatible)
         net10.0 TFM confirmed via nuget.org/packages/MudBlazor/9.3.0 (see 03-RESEARCH.md §Version verification). -->
    <PackageVersion Include="MudBlazor" Version="9.3.0" />

    <!-- Phase 03.1 Admin UI redesign — bUnit 2.0.66 (test-only) verified GA on net10.0 2025-11-21 (MIT / GPL-compatible).
         Test-only dependency: ships ONLY inside tests/* and never in the 6 runtime NuGet packages. CLAUDE.md
         "no new NuGet packages" applies to runtime distributables; test infrastructure is conventionally
         exempt. AngleSharp resolves transitively. See 03.1-RESEARCH.md §Standard Stack. -->
    <PackageVersion Include="bunit" Version="2.0.66" />

    <!-- Phase 4 Plan 06 — Polly v8 for RankingsTickerLeaseHelper retry pipeline.
         Pinned deterministically: 8.5.2 is the latest stable 8.5.x patch on nuget.org
         (released 2025-02-04). Transitive via Microsoft.Extensions.Http.Resilience but
         the ticker needs ResiliencePipelineBuilder directly for non-HTTP use (CLAUDE.md §7). -->
    <PackageVersion Include="Polly" Version="8.5.2" />

    <!-- Transitive pin to override WireMock.Net.OpenTelemetry/2.2.0's pull of OpenTelemetry.* 1.14.0,
         which carries moderate-severity advisories (GHSA-g94r-2vxg-569j, GHSA-mr8r-92fq-pj8p,
         GHSA-q834-8qmm-v933). 1.15.3 is the lowest stable line clean of all three. The full sibling
         set is pinned together to keep the OTel version graph internally consistent — partial bumps
         leave inter-OTel constraints inconsistent. CentralPackageTransitivePinningEnabled honors these
         pins for transitive resolution. Do not downgrade. -->
    <PackageVersion Include="OpenTelemetry" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Api.ProviderBuilderExtensions" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <!-- Instrumentation.* sit on a separate release cadence from the core SDK; 1.15.2 is the latest
         on this line and is not flagged by the advisories above. -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />

    <!-- Phase 13 Plan 01 — Roslyn analyzer test harness (OBS-07 PII lint gate tests).
         Both packages: Microsoft/RoslynTeam, dotnet/roslyn-analyzers source repo.
         Operator-approved in slopcheck gate (Task 1, checkpoint:human-verify passed 2026-06-14).
         Test-only: consumed exclusively by tests/GameKit.Build.Tests/.
         Note: XUnit 1.1.2 requires exact-match siblings; both pinned at 1.1.2 for version parity.
         Plan specified 1.1.4 for the base package, but 1.1.2 satisfies the XUnit constraint without
         mismatched sibling versions (Rule 1 auto-fix, NU1608). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.XUnit" Version="1.1.2" />
    <!-- Transitive pins for the analyzer-testing packages' Roslyn deps.
         CentralPackageTransitivePinningEnabled=true pulls old 1.0.1 Roslyn packages unless
         these are pinned to modern versions. 4.13.0 matches GameKit.Build.csproj's inline pin.
         Rule 1 auto-fix: NU1701 blocking the analyzer test project restore. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="4.13.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.13.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.13.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzer.Testing" Version="1.1.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Testing.Verifiers.XUnit" Version="1.1.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Applied globally to every csproj -->
    <GlobalPackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.202" PrivateAssets="all" />
  </ItemGroup>
</Project>
