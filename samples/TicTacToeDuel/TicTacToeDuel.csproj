<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>TicTacToeDuel</RootNamespace>
    <AssemblyName>TicTacToeDuel</AssemblyName>
    <!-- TicTacToeDuel is not a NuGet package -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GameKit.Core\GameKit.Core.csproj" />
    <ProjectReference Include="..\..\src\GameKit.Auth\GameKit.Auth.csproj" />
    <ProjectReference Include="..\..\src\GameKit.Rankings\GameKit.Rankings.csproj" />
    <ProjectReference Include="..\..\src\GameKit.Matchmaking\GameKit.Matchmaking.csproj" />
    <!-- v2.0 — Lobby package: SignalR lobby hub (/hubs/lobby) + Redis backplane (LOBBY-06). -->
    <ProjectReference Include="..\..\src\GameKit.Lobby\GameKit.Lobby.csproj" />
    <!-- Plan 06-04 — Presence package: Redis TTL-keyed heartbeat + in-match precedence Lua. -->
    <ProjectReference Include="..\..\src\GameKit.Presence\GameKit.Presence.csproj" />
    <!-- Plan 06-06 — OpenApi package: combined /openapi/v1.json document with bearerAuth
         scheme + inline admin-route exclusion (D-19). -->
    <ProjectReference Include="..\..\src\GameKit.OpenApi\GameKit.OpenApi.csproj" />
    <ProjectReference Include="..\..\src\GameKit.Admin.UI\GameKit.Admin.UI.csproj" />
  </ItemGroup>
  <!-- Phase 15 (OBS-04/05/06) — OpenTelemetry SDK. GameKit.Core declares these PrivateAssets="all"
       (OBS-01), so a consumer that wants observability opts in by referencing the SDK itself. The
       Hosting + OTLP-exporter packages back AddGameKitObservability(); the AspNetCore instrumentation
       produces the HTTP server span that the matchmaking MatchFormation span descends from (OBS-06). -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
  </ItemGroup>
</Project>
