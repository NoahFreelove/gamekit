{
  "id": null,
  "uid": "gamekit-ticker-health",
  "title": "GameKit: Ticker Health",
  "description": "Matchmaking and rankings ticker health: tick duration, lease acquisition, pool sweep duration. Panels show no-data until Phase 15 instrumentation lands.",
  "tags": ["gamekit", "matchmaking", "rankings"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m"]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Ticker Lag (p50 / p99)",
      "description": "Matchmaking ticker wall-clock lag histogram (matchmaking.ticker.lag). Phase 15 wired MatchmakerTickerService instrumentation.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, rate(gamekit_matchmaking_ticker_lag_ms_bucket[5m]))",
          "legendFormat": "p50 ms"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, rate(gamekit_matchmaking_ticker_lag_ms_bucket[5m]))",
          "legendFormat": "p99 ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 40 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Lease Acquired / Lost Rate",
      "description": "Rate of Redis distributed lock acquisition and loss events for the matchmaking ticker.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(gamekit_matchmaking_lease_acquired_total[5m])",
          "legendFormat": "acquired/s"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(gamekit_matchmaking_lease_lost_total[5m])",
          "legendFormat": "lost/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Pool Sweep Duration (p50 / p99)",
      "description": "Per-pool sweep duration within a single ticker iteration.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, rate(gamekit_matchmaking_pool_sweep_duration_ms_bucket[5m]))",
          "legendFormat": "p50 ms ({{ladder_id}})"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, rate(gamekit_matchmaking_pool_sweep_duration_ms_bucket[5m]))",
          "legendFormat": "p99 ms ({{ladder_id}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Rankings Ticker: Decay Duration",
      "description": "Rankings decay job duration histogram (rankings.decay.duration). Phase 15 wired RankDecayBackgroundService instrumentation.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, rate(gamekit_rankings_decay_duration_ms_bucket[5m]))",
          "legendFormat": "p50 ms ({{ladder_id}})"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, rate(gamekit_rankings_decay_duration_ms_bucket[5m]))",
          "legendFormat": "p99 ms ({{ladder_id}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Datasource",
        "pluginId": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  }
}
