@*
    Root Blazor Server component for GameKit.Admin.UI.
    Responsibilities (per UI-SPEC §Asset Loading + CONTEXT D-15 + 03-RESEARCH §Threading the nonce):
    * Emit a self-contained HTML document (HEAD + BODY) with exactly three stylesheets:
      - _content/MudBlazor/MudBlazor.min.css    (component library)
      - _content/GameKit.Admin.UI/GameKit.Admin.UI.bundle.scp.css  (Blazor CSS-isolation bundle)
      - _content/GameKit.Admin.UI/gamekit-admin.css                (shell custom properties)
    * Thread the per-request CSP nonce (produced by AdminCspNonceMiddleware) into every
      <script nonce="..."> tag so the strict script-src 'self' 'nonce-...' CSP allows the
      Blazor Server circuit + MudBlazor JS interop.
    * No CDN references. No inline <style>. Tabular numerals + focus ring live in gamekit-admin.css.
*@
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en" class="gk-admin-root">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>GameKit Admin</title>
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="_content/GameKit.Admin.UI/GameKit.Admin.UI.bundle.scp.css" />
    <link rel="stylesheet" href="_content/GameKit.Admin.UI/gamekit-admin.css" />
    <HeadOutlet />
    @* Phase 03.1 D-06 + RESEARCH §Pattern 4 — FOUC eliminator. Reads localStorage and applies
       five [data-*] attributes on <html> BEFORE <body> paints. CSP-strict: nonce required. *@
    <script nonce="@Nonce">
      (function () {
        try {
          var t = JSON.parse(localStorage.getItem('gamekit.admin.tweaks') || '{}');
          var h = document.documentElement;
          h.setAttribute('data-accent',         t.accent   || 'violet');
          h.setAttribute('data-density',        t.density  || 'compact');
          h.setAttribute('data-sidebar',        t.sidebar  || 'expanded');
          h.setAttribute('data-ban-loud',       t.banLoud  || 'medium');
          h.setAttribute('data-dashboard-dir',  t.dashDir  || 'D');
        } catch (e) { /* corrupt JSON — defaults applied above */ }
      })();
    </script>
</head>
<body>
    @*
        Per-page rendermode: pages decorated with [ExcludeFromInteractiveRouting] (currently
        Login.razor) render as static SSR so real HTML form submissions work — required for
        cookie-mutating endpoints. Every other admin page gets InteractiveServer.
    *@
    <Routes @rendermode="@PageRenderMode" />
    @* UI-SPEC §Asset Loading + CONTEXT D-15: every script tag gets the per-request nonce. *@
    <script src="_framework/blazor.web.js" nonce="@Nonce"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js" nonce="@Nonce"></script>
    @* Phase 03.1 D-05 / RESEARCH §Pattern 6 — vanilla JS interactivity bundle (palette / tweaks /
       sidebar / clipboard / audit). Same-origin static — script-src 'self' covers; no nonce. *@
    <script src="_content/GameKit.Admin.UI/gamekit-admin.js" defer></script>
</body>
</html>

@code {
    /// <summary>
    /// Per-request CSP nonce emitted by <see cref="AdminCspNonceMiddleware"/>. Read via
    /// <see cref="IHttpContextAccessor"/>; returns <c>null</c> if the middleware did not run
    /// (non-admin request path), in which case the empty attribute value is harmless because
    /// CSP only enforces on admin-prefixed responses.
    /// </summary>
    private string? Nonce =>
        HttpContextAccessor.HttpContext?.Items[AdminCspNonceMiddleware.NonceItemKey] as string;

    /// <summary>
    /// Per-request rendermode for the <c>Routes</c> root: <c>InteractiveServer</c> for the
    /// authenticated admin pages, <c>null</c> (static SSR) for pages marked
    /// <see cref="ExcludeFromInteractiveRoutingAttribute"/>. Falls back to interactive when
    /// the HTTP context is unavailable (defensive — should not happen on admin paths).
    /// </summary>
    private IComponentRenderMode? PageRenderMode =>
        HttpContextAccessor.HttpContext?.AcceptsInteractiveRouting() == false
            ? null
            : RenderMode.InteractiveServer;
}
