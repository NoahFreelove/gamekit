@*
    UI-SPEC §6 Ban dialog — MudDialog with danger-subtle top stripe, multiline reason field
    with client-side 3–512 char validation backed by FluentValidation (BanPlayerRequestValidator).

    DI PATTERN: dialog calls IPlayerBanService.BanAsync directly via DI. We do NOT round-trip
    through HTTP loopback to /admin/api/players/{id}/ban — see the architecture note in
    AdminEndpoints.cs. Loopback would require the server to forward the user's auth cookie to
    itself (it can't), so the endpoint would 401. Direct DI access also drops the antiforgery
    round-trip (the dialog runs inside the Blazor circuit's authenticated identity; CSRF
    protection on the JSON endpoint exists for external SPA / curl callers, not for in-process
    Blazor pages). Validator is invoked inline so the user sees the same messages without the
    HTTP roundtrip; the service is the authoritative validation site downstream.

    On success: dialog closes with Data=true. On validation failure: inline field error.
    On unexpected exception: inline alert (retryable).
*@
@namespace GameKit.Admin.UI.Components.Dialogs
@using GameKit.Admin.UI.Http.Contracts
@inject IPlayerBanService BanService
@inject FluentValidation.IValidator<BanPlayerRequest> Validator
@inject AuthenticationStateProvider AuthState

<MudDialog Class="dialog dialog-danger">
    <TitleContent>
        <span>Ban @DisplayName?</span>
    </TitleContent>
    <DialogContent>
        @* Plan 03.1-08 — re-skinned to sketch's .dialog-body affordance; the Danger
           treatment now lives on the dialog wrapper class (see gamekit-admin.css). *@
        <MudText Typo="Typo.body2" Color="Color.Default" Class="dialog-body">
            Banned players cannot sign in. Existing sessions self-expire within 15 minutes.
            This action writes an entry to the admin audit log. You can unban later.
        </MudText>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" role="alert">@_errorMessage</MudAlert>
        }

        <MudTextField T="string"
                      @bind-Value="_reason"
                      Label="Reason (visible to admins only)"
                      Placeholder="e.g. Chat harassment in session 0196…"
                      HelperText="3–512 characters. Stored verbatim in the audit log."
                      Lines="3"
                      Variant="Variant.Outlined"
                      Error="@_reasonError"
                      ErrorText="@_reasonErrorMessage"
                      Disabled="@_submitting"
                      FullWidth="true" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="@_submitting">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="SubmitAsync" Disabled="@_submitting">
            @if (_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                <span>Banning…</span>
            }
            else
            {
                <span>Ban player</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>MudDialog instance reference — required to close from within the component.</summary>
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    /// <summary>Target player id.</summary>
    [Parameter, EditorRequired] public Guid PlayerId { get; set; }

    /// <summary>Target player display name (rendered in title + dialog body).</summary>
    [Parameter, EditorRequired] public string DisplayName { get; set; } = string.Empty;

    private string _reason = string.Empty;
    private bool _reasonError;
    private string? _reasonErrorMessage;
    private bool _submitting;
    private string? _errorMessage;

    private void Cancel() => MudDialog?.Cancel();

    private async Task SubmitAsync()
    {
        _reasonError = false;
        _reasonErrorMessage = null;
        _errorMessage = null;

        var req = new BanPlayerRequest(_reason);
        var validation = await Validator.ValidateAsync(req);
        if (!validation.IsValid)
        {
            _reasonError = true;
            _reasonErrorMessage = validation.Errors[0].ErrorMessage;
            return;
        }

        _submitting = true;
        try
        {
            var actorId = await GetActorIdAsync();
            await BanService.BanAsync(PlayerId, actorId, req.Reason, CancellationToken.None);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ban failed: {ex.Message}. Try again.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task<Guid> GetActorIdAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var nameId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        return Guid.TryParse(nameId, out var id)
            ? id
            : throw new InvalidOperationException(
                "Admin id claim is missing — dialog must run inside an authenticated admin session.");
    }
}
