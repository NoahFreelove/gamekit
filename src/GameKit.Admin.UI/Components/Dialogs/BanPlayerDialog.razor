@*
    UI-SPEC §6 Ban dialog — MudDialog with danger-subtle top stripe, multiline reason field
    with client-side 3–512 char validation mirroring BanPlayerRequestValidator verbatim.

    CSRF pattern (W9 PRESCRIPTIVE): inject IAntiforgery + IHttpContextAccessor, capture
    AntiforgeryTokenSet on init, attach X-GameKit-Admin-CSRF header on submit.

    On 200: dialog closes with Data=true. On 400: ValidationProblem rendered inline.
    On 403/404: error alert (retryable).
*@
@namespace GameKit.Admin.UI.Components.Dialogs
@using System.Net
@using System.Net.Http.Json
@using GameKit.Admin.UI.Authentication
@using GameKit.Admin.UI.Http.Contracts
@using Microsoft.AspNetCore.Antiforgery
@inject HttpClient Http
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor

<MudDialog>
    <TitleContent>
        <span>Ban @DisplayName?</span>
    </TitleContent>
    <DialogContent>
        <div class="gk-dialog-danger-stripe"></div>
        <MudText Typo="Typo.body2" Color="Color.Default" Class="gk-dialog-body">
            Banned players cannot sign in. Existing sessions self-expire within 15 minutes.
            This action writes an entry to the admin audit log. You can unban later.
        </MudText>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" role="alert">@_errorMessage</MudAlert>
        }

        <MudTextField T="string"
                      @bind-Value="_reason"
                      Label="Reason (visible to admins only)"
                      Placeholder="e.g. Chat harassment in session 0196…"
                      HelperText="3–512 characters. Stored verbatim in the audit log."
                      Lines="3"
                      Variant="Variant.Outlined"
                      Error="@_reasonError"
                      ErrorText="@_reasonErrorMessage"
                      Disabled="@_submitting"
                      FullWidth="true" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="@_submitting">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="SubmitAsync" Disabled="@_submitting">
            @if (_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                <span>Banning…</span>
            }
            else
            {
                <span>Ban player</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>MudDialog instance reference — required to close from within the component.</summary>
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    /// <summary>Target player id.</summary>
    [Parameter, EditorRequired] public Guid PlayerId { get; set; }

    /// <summary>Target player display name (rendered in title + dialog body).</summary>
    [Parameter, EditorRequired] public string DisplayName { get; set; } = string.Empty;

    private string _reason = string.Empty;
    private bool _reasonError;
    private string? _reasonErrorMessage;
    private bool _submitting;
    private string? _errorMessage;
    private AntiforgeryTokenSet? _tokens;

    protected override void OnInitialized()
    {
        var ctx = HttpContextAccessor.HttpContext
            ?? throw new InvalidOperationException("No HttpContext — dialog must render within a Blazor Server request.");
        _tokens = Antiforgery.GetAndStoreTokens(ctx);
    }

    private void Cancel() => MudDialog?.Cancel();

    private async Task SubmitAsync()
    {
        // Client-side validation mirrors BanPlayerRequestValidator verbatim so users see the
        // same messages without a round-trip to the server. Defense-in-depth only — the
        // server validator is authoritative.
        _reasonError = false;
        _reasonErrorMessage = null;
        if (string.IsNullOrEmpty(_reason))
        {
            _reasonError = true;
            _reasonErrorMessage = "A reason is required.";
            return;
        }
        if (_reason.Length < 3)
        {
            _reasonError = true;
            _reasonErrorMessage = "Reason must be at least 3 characters.";
            return;
        }
        if (_reason.Length > 512)
        {
            _reasonError = true;
            _reasonErrorMessage = "Reason is too long (max 512 characters).";
            return;
        }

        _submitting = true;
        _errorMessage = null;
        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Post, $"/admin/api/players/{PlayerId}/ban")
            {
                Content = JsonContent.Create(new BanPlayerRequest(_reason)),
            };
            if (_tokens?.RequestToken is { } token)
            {
                request.Headers.Add(AdminAuthenticationSchemeConstants.CsrfHeaderName, token);
            }
            var resp = await Http.SendAsync(request);

            switch (resp.StatusCode)
            {
                case HttpStatusCode.NoContent:
                case HttpStatusCode.OK:
                    MudDialog?.Close(DialogResult.Ok(true));
                    return;
                case HttpStatusCode.BadRequest:
                    _reasonError = true;
                    _reasonErrorMessage = "Reason is invalid. Check the length and try again.";
                    break;
                case HttpStatusCode.Forbidden:
                    _errorMessage = "This action requires superadmin. Ask another admin to perform it.";
                    break;
                case HttpStatusCode.NotFound:
                    _errorMessage = "Player not found. The page may be out of date.";
                    break;
                default:
                    _errorMessage = $"Ban failed: server returned {(int)resp.StatusCode}. Try again.";
                    break;
            }
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = $"Ban failed: {ex.Message}. Try again.";
        }
        finally
        {
            _submitting = false;
        }
    }
}
