@*
    UI-SPEC §13 Create admin dialog — Username + Password + Confirm + Role select.
    Calls IAdminUserService.CreateAsync directly via DI. See architecture note in
    AdminEndpoints.cs and the longer rationale in BanPlayerDialog.razor. Validator
    (CreateAdminRequestValidator) is invoked inline so the user sees the same messages
    without an HTTP roundtrip; service is the authoritative validation site downstream.

    Confirm-password is a UI-only constraint (not part of the DTO) so we keep it as a
    separate inline check before calling the validator.
*@
@namespace GameKit.Admin.UI.Components.Dialogs
@inject IAdminUserService AdminUsers
@inject FluentValidation.IValidator<CreateAdminRequest> Validator
@inject AuthenticationStateProvider AuthState

<MudDialog Class="dialog">
    <TitleContent>
        <span>Create admin</span>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" role="alert">@_errorMessage</MudAlert>
        }

        <MudTextField T="string"
                      @bind-Value="_username"
                      Label="Username"
                      Variant="Variant.Outlined"
                      Error="@_usernameError"
                      ErrorText="@_usernameErrorMessage"
                      Disabled="@_submitting"
                      HelperText="3–32 chars, lowercase letters, digits, underscore, or hyphen." />

        <MudTextField T="string"
                      @bind-Value="_password"
                      Label="Password"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Error="@_passwordError"
                      ErrorText="@_passwordErrorMessage"
                      Disabled="@_submitting"
                      HelperText="At least 12 characters recommended." />

        <MudTextField T="string"
                      @bind-Value="_confirmPassword"
                      Label="Confirm password"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Error="@_confirmError"
                      ErrorText="@_confirmErrorMessage"
                      Disabled="@_submitting" />

        <MudSelect T="string"
                   @bind-Value="_role"
                   Label="Role"
                   Variant="Variant.Outlined"
                   Disabled="@_submitting">
            <MudSelectItem T="string" Value="@AdminRoles.Admin">admin</MudSelectItem>
            <MudSelectItem T="string" Value="@AdminRoles.Superadmin">superadmin</MudSelectItem>
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="@_submitting">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="@_submitting">
            @if (_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                <span>Creating…</span>
            }
            else
            {
                <span>Create admin</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    private string _username = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private string _role = AdminRoles.Admin;

    private bool _usernameError;
    private string? _usernameErrorMessage;
    private bool _passwordError;
    private string? _passwordErrorMessage;
    private bool _confirmError;
    private string? _confirmErrorMessage;

    private bool _submitting;
    private string? _errorMessage;

    private void Cancel() => MudDialog?.Cancel();

    private async Task SubmitAsync()
    {
        _usernameError = _passwordError = _confirmError = false;
        _usernameErrorMessage = _passwordErrorMessage = _confirmErrorMessage = null;
        _errorMessage = null;

        // Confirm-password is a UI-only constraint not part of the DTO; check it inline.
        if (_password != _confirmPassword)
        {
            _confirmError = true;
            _confirmErrorMessage = "Passwords do not match.";
            return;
        }

        var req = new CreateAdminRequest(_username, _password, _role);
        var validation = await Validator.ValidateAsync(req);
        if (!validation.IsValid)
        {
            // Map validator failures back to the right field. PropertyName matches the DTO
            // record positional names (Username / Password / Role).
            foreach (var failure in validation.Errors)
            {
                switch (failure.PropertyName)
                {
                    case nameof(CreateAdminRequest.Username):
                        _usernameError = true;
                        _usernameErrorMessage ??= failure.ErrorMessage;
                        break;
                    case nameof(CreateAdminRequest.Password):
                        _passwordError = true;
                        _passwordErrorMessage ??= failure.ErrorMessage;
                        break;
                    case nameof(CreateAdminRequest.Role):
                        _errorMessage ??= failure.ErrorMessage;
                        break;
                    default:
                        _errorMessage ??= failure.ErrorMessage;
                        break;
                }
            }
            return;
        }

        _submitting = true;
        try
        {
            var actorId = await GetActorIdAsync();
            await AdminUsers.CreateAsync(req.Username, req.Password, req.Role, actorId, CancellationToken.None);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (AdminUsernameAlreadyTakenException ex)
        {
            _usernameError = true;
            _usernameErrorMessage = $"Username '{ex.Username}' is already taken.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Create failed: {ex.Message}. Try again.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task<Guid> GetActorIdAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var nameId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        return Guid.TryParse(nameId, out var id)
            ? id
            : throw new InvalidOperationException(
                "Admin id claim is missing — dialog must run inside an authenticated admin session.");
    }
}
