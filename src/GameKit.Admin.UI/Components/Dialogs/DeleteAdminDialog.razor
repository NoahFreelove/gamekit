@*
    UI-SPEC §13 Delete admin dialog — one-step confirmation (no retype), danger color,
    copy: "Delete admin \"{username}\"? This cannot be undone. The audit log records this
    action." Calls IAdminUserService.DeleteAsync directly via DI.

    Server enforces the last-superadmin guard via LastSuperadminException; the UI surfaces
    the message inline if the guard fires despite the client-side disable on the parent page.
    See architecture note in AdminEndpoints.cs and rationale in BanPlayerDialog.razor.
*@
@namespace GameKit.Admin.UI.Components.Dialogs
@inject IAdminUserService AdminUsers
@inject AuthenticationStateProvider AuthState

<MudDialog Class="dialog dialog-danger">
    <TitleContent>
        <span>Delete admin "@Username"?</span>
    </TitleContent>
    <DialogContent>
        @* Plan 03.1-08 — re-skinned: danger affordance now on the wrapper. *@
        <MudText Typo="Typo.body2" Color="Color.Default" Class="dialog-body">
            Delete admin "@Username"? This cannot be undone. The audit log records this action.
        </MudText>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" role="alert">@_errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="@_submitting">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="SubmitAsync" Disabled="@_submitting">
            @if (_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                <span>Deleting…</span>
            }
            else
            {
                <span>Delete admin</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter, EditorRequired] public Guid AdminId { get; set; }
    [Parameter, EditorRequired] public string Username { get; set; } = string.Empty;

    private bool _submitting;
    private string? _errorMessage;

    private void Cancel() => MudDialog?.Cancel();

    private async Task SubmitAsync()
    {
        _submitting = true;
        _errorMessage = null;
        try
        {
            var actorId = await GetActorIdAsync();
            await AdminUsers.DeleteAsync(AdminId, actorId, CancellationToken.None);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (LastSuperadminException)
        {
            _errorMessage = "Cannot delete the last superadmin. Create another superadmin first.";
        }
        catch (KeyNotFoundException)
        {
            _errorMessage = "Admin not found. The page may be out of date.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Delete failed: {ex.Message}. Try again.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task<Guid> GetActorIdAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var nameId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        return Guid.TryParse(nameId, out var id)
            ? id
            : throw new InvalidOperationException(
                "Admin id claim is missing — dialog must run inside an authenticated admin session.");
    }
}
