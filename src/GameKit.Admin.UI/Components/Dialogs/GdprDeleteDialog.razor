@*
    UI-SPEC §8 GDPR delete dialog — superadmin-only, two-step confirmation:
      1. Operator types the display_name exactly (case-sensitive) to enable the delete button.
      2. Operator clicks Delete player.

    Danger stripe (solid — stronger than Ban dialog's subtle stripe) + irreversibility copy.

    Calls IGdprDeleteService.DeletePlayerAsync (Core audit row written there) plus
    IAdminAuditWriter.WriteAsync (admin-scoped audit row so the admin-UI audit viewer
    surfaces the action under admin.player.gdpr_delete). Mirrors the dual-write the
    /admin/api/players/{id}/gdpr-delete endpoint does. See architecture note in
    AdminEndpoints.cs and the longer rationale in BanPlayerDialog.razor.
*@
@namespace GameKit.Admin.UI.Components.Dialogs
@using GameKit.Core.Services
@inject IGdprDeleteService GdprDelete
@inject IAdminAuditWriter Audit
@inject AuthenticationStateProvider AuthState

<MudDialog Class="dialog dialog-danger">
    <TitleContent>
        <span>Delete @DisplayName permanently?</span>
    </TitleContent>
    <DialogContent>
        @* Plan 03.1-08 — re-skinned: danger affordance now on the wrapper. *@
        <MudText Typo="Typo.body2" Color="Color.Default" Class="dialog-body">
            This is irreversible. The player's profile, identities, password credential, and
            session participation records will be anonymized or removed. Opponent foreign keys
            will be set to NULL. Rating history becomes unattributable. The admin audit log
            entry for this action is retained.
        </MudText>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" role="alert">@_errorMessage</MudAlert>
        }

        <MudTextField T="string"
                      @bind-Value="_confirmText"
                      @bind-Value:after="OnConfirmChanged"
                      Label="@($"Type \"{DisplayName}\" to confirm")"
                      Variant="Variant.Outlined"
                      Disabled="@_submitting"
                      FullWidth="true" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="@_submitting">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   OnClick="SubmitAsync"
                   Disabled="@(_submitting || !_confirmMatches)">
            @if (_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                <span>Deleting…</span>
            }
            else
            {
                <span>Delete player</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter, EditorRequired] public Guid PlayerId { get; set; }
    [Parameter, EditorRequired] public string DisplayName { get; set; } = string.Empty;

    private string _confirmText = string.Empty;
    private bool _confirmMatches;
    private bool _submitting;
    private string? _errorMessage;

    private void OnConfirmChanged()
    {
        // Case-sensitive equality — UI-SPEC §8.
        _confirmMatches = string.Equals(_confirmText, DisplayName, StringComparison.Ordinal);
    }

    private void Cancel() => MudDialog?.Cancel();

    private async Task SubmitAsync()
    {
        if (!_confirmMatches) return;
        _submitting = true;
        _errorMessage = null;
        try
        {
            var actorId = await GetActorIdAsync();
            const string reason = "gdpr_request";

            await GdprDelete.DeletePlayerAsync(PlayerId, actorId, reason, CancellationToken.None);

            // Admin-scoped audit row (mirrors /admin/api/players/{id}/gdpr-delete) so the
            // admin-UI audit viewer surfaces the action under admin.player.gdpr_delete in
            // addition to the Core gdpr_delete row written inside the service.
            await Audit.WriteAsync(
                action: AdminAuditActions.PlayerGdprDelete,
                targetType: "player",
                targetId: PlayerId,
                actorId: actorId,
                before: null,
                after: new { deleted = true, confirm_username = DisplayName },
                reason: reason,
                cancellationToken: CancellationToken.None);

            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (PlayerNotFoundException)
        {
            _errorMessage = "Player not found. The database was not changed.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Delete failed: {ex.Message}. The database was not changed. Try again or contact another superadmin.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task<Guid> GetActorIdAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var nameId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        return Guid.TryParse(nameId, out var id)
            ? id
            : throw new InvalidOperationException(
                "Admin id claim is missing — dialog must run inside an authenticated admin session.");
    }
}
