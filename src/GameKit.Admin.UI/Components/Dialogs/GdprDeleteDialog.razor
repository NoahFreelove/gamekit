@*
    UI-SPEC §8 GDPR delete dialog — superadmin-only, two-step confirmation:
      1. Operator types the display_name exactly (case-sensitive) to enable the delete button.
      2. Operator clicks Delete player.

    Danger stripe (solid — stronger than Ban dialog's subtle stripe) + irreversibility copy.

    CSRF pattern (W9 PRESCRIPTIVE): inject IAntiforgery + IHttpContextAccessor, capture
    AntiforgeryTokenSet on init, attach X-GameKit-Admin-CSRF header on submit.
*@
@namespace GameKit.Admin.UI.Components.Dialogs
@using System.Net
@using System.Net.Http.Json
@using GameKit.Admin.UI.Authentication
@using GameKit.Admin.UI.Http.Contracts
@using Microsoft.AspNetCore.Antiforgery
@inject HttpClient Http
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor

<MudDialog>
    <TitleContent>
        <span>Delete @DisplayName permanently?</span>
    </TitleContent>
    <DialogContent>
        <div class="gk-dialog-danger-stripe gk-dialog-danger-stripe-solid"></div>
        <MudText Typo="Typo.body2" Color="Color.Default" Class="gk-dialog-body">
            This is irreversible. The player's profile, identities, password credential, and
            session participation records will be anonymized or removed. Opponent foreign keys
            will be set to NULL. Rating history becomes unattributable. The admin audit log
            entry for this action is retained.
        </MudText>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" role="alert">@_errorMessage</MudAlert>
        }

        <MudTextField T="string"
                      @bind-Value="_confirmText"
                      @bind-Value:after="OnConfirmChanged"
                      Label="@($"Type \"{DisplayName}\" to confirm")"
                      Variant="Variant.Outlined"
                      Disabled="@_submitting"
                      FullWidth="true" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="@_submitting">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   OnClick="SubmitAsync"
                   Disabled="@(_submitting || !_confirmMatches)">
            @if (_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                <span>Deleting…</span>
            }
            else
            {
                <span>Delete player</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter, EditorRequired] public Guid PlayerId { get; set; }
    [Parameter, EditorRequired] public string DisplayName { get; set; } = string.Empty;

    private string _confirmText = string.Empty;
    private bool _confirmMatches;
    private bool _submitting;
    private string? _errorMessage;
    private AntiforgeryTokenSet? _tokens;

    protected override void OnInitialized()
    {
        var ctx = HttpContextAccessor.HttpContext
            ?? throw new InvalidOperationException("No HttpContext — dialog must render within a Blazor Server request.");
        _tokens = Antiforgery.GetAndStoreTokens(ctx);
    }

    private void OnConfirmChanged()
    {
        // Case-sensitive equality — UI-SPEC §8.
        _confirmMatches = string.Equals(_confirmText, DisplayName, StringComparison.Ordinal);
    }

    private void Cancel() => MudDialog?.Cancel();

    private async Task SubmitAsync()
    {
        if (!_confirmMatches) return;
        _submitting = true;
        _errorMessage = null;
        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Post, $"/admin/api/players/{PlayerId}/gdpr-delete")
            {
                Content = JsonContent.Create(new GdprDeleteRequest(DisplayName, "gdpr_request")),
            };
            if (_tokens?.RequestToken is { } token)
            {
                request.Headers.Add(AdminAuthenticationSchemeConstants.CsrfHeaderName, token);
            }
            var resp = await Http.SendAsync(request);

            if (resp.StatusCode is HttpStatusCode.NoContent or HttpStatusCode.OK)
            {
                MudDialog?.Close(DialogResult.Ok(true));
                return;
            }
            _errorMessage = resp.StatusCode switch
            {
                HttpStatusCode.Forbidden => "This action requires superadmin. Ask another admin to perform it.",
                HttpStatusCode.NotFound => "Player not found. The database was not changed.",
                _ => $"Delete failed: server returned {(int)resp.StatusCode}. The database was not changed. Try again or contact another superadmin.",
            };
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = $"Delete failed: {ex.Message}. The database was not changed. Try again or contact another superadmin.";
        }
        finally
        {
            _submitting = false;
        }
    }
}
