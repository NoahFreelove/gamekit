@*
    UI-SPEC §7 Unban dialog — same shape as Ban (warning color, reason optional). Calls
    IPlayerBanService.UnbanAsync directly via DI. See the architecture note in
    AdminEndpoints.cs and the longer rationale in BanPlayerDialog.razor.
*@
@namespace GameKit.Admin.UI.Components.Dialogs
@inject IPlayerBanService BanService
@inject AuthenticationStateProvider AuthState

<MudDialog Class="dialog dialog-warn">
    <TitleContent>
        <span>Unban @DisplayName?</span>
    </TitleContent>
    <DialogContent>
        @* Plan 03.1-08 — re-skinned: .dialog-body class for sketch spacing token. *@
        <MudText Typo="Typo.body2" Color="Color.Default" Class="dialog-body">
            Unbanning restores this player's ability to sign in and refresh sessions.
        </MudText>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" role="alert">@_errorMessage</MudAlert>
        }

        <MudTextField T="string"
                      @bind-Value="_reason"
                      Label="Reason (optional)"
                      HelperText="Optional — documents why the ban is being lifted."
                      Lines="3"
                      Variant="Variant.Outlined"
                      Disabled="@_submitting"
                      FullWidth="true" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="@_submitting">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="SubmitAsync" Disabled="@_submitting">
            @if (_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                <span>Unbanning…</span>
            }
            else
            {
                <span>Unban player</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter, EditorRequired] public Guid PlayerId { get; set; }
    [Parameter, EditorRequired] public string DisplayName { get; set; } = string.Empty;

    private string _reason = string.Empty;
    private bool _submitting;
    private string? _errorMessage;

    private void Cancel() => MudDialog?.Cancel();

    private async Task SubmitAsync()
    {
        _submitting = true;
        _errorMessage = null;
        try
        {
            var actorId = await GetActorIdAsync();
            var reason = string.IsNullOrWhiteSpace(_reason) ? null : _reason;
            await BanService.UnbanAsync(PlayerId, actorId, reason, CancellationToken.None);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unban failed: {ex.Message}. Try again.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task<Guid> GetActorIdAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var nameId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        return Guid.TryParse(nameId, out var id)
            ? id
            : throw new InvalidOperationException(
                "Admin id claim is missing — dialog must run inside an authenticated admin session.");
    }
}
