@*
    Primary admin shell layout — used by every authenticated page under /admin/*
    except /admin/login (which uses LoginLayout).

    UI-SPEC §Layout Shell:
    - Top nav: 56px fixed, surface bg, 1px bottom border.
    - Sidebar: 240px expanded / 64px collapsed, persistent on desktop.
    - Content area: fills remaining space, scrolls independently, outer padding lg (24px).

    UI-SPEC §Component Inventory: exactly one MudThemeProvider + MudPopoverProvider +
    MudDialogProvider + MudSnackbarProvider at the root of the rendered tree (UI-SPEC §7
    pitfall: double-mounting any provider causes dialog/snackbar double-render).

    Snackbar position/max-displayed are controlled via AddMudServices(...) in DI (plan 03-06
    DI wiring). Values declared here on <MudSnackbarProvider> are not honored by the 9.x
    component (no Position/MaxDisplayed parameters); position defaults to BottomRight.
*@
@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject IDialogService Dialogs
@using Microsoft.JSInterop
@using GameKit.Admin.UI.Components.Dialogs
@using GameKit.Admin.UI.Components.Shared

<MudThemeProvider Theme="@GameKitAdminTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* Phase 03.1 D-09 — verb-engine command palette mounted once at layout root. Hidden by
   CSS until [data-palette-open] flips on <html> via gamekit-admin.js (Plan 03 owns the
   key listener + filter; this component owns the role-filtered SSR markup). *@
<CommandPalette />

@* Phase 03.1 D-06 — runtime tweaks drawer (5 toggles + reset). Hidden until
   [data-tweaks-open] flips on <html> via gamekit-admin.js openTweaks(). *@
<TweaksPanel />

<MudLayout>
    <TopNav OnToggleDrawer="ToggleDrawer" />
    <MudDrawer @bind-Open="_drawerOpen"
               Elevation="0"
               Variant="DrawerVariant.Persistent"
               ClipMode="DrawerClipMode.Always"
               Width="240px"
               MiniWidth="64px">
        <SideNav />
    </MudDrawer>
    <MudMainContent>
        @* UI-SPEC §Layout Shell — content-area outer padding = lg (32px from sketch density tokens). *@
        <div class="gk-content">
            @* UI-SPEC §Min viewport banner — <1024px shows a warning (CSS handles visibility). *@
            <div class="gk-viewport-warning" role="status">
                GameKit Admin is designed for desktop. Some views may overflow.
            </div>
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    // UI-SPEC §Sidebar — persistent on desktop; collapse toggle lives on the top nav.
    // State is component-local here; CONTEXT mentions a future cookie (gk_admin_sidebar)
    // to survive reload — deferred to a later plan.
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private DotNetObjectReference<MainLayout>? _selfRef;

    /// <summary>
    /// Registers the JS-to-Blazor bridge with <c>window.GKAdmin</c> after the first render.
    /// Cannot run during <c>OnInitializedAsync</c> because JS interop is unavailable during
    /// Blazor Server pre-render — <c>firstRender == true</c> is the earliest safe point.
    /// Plan 04's CommandPalette dispatches actions through this bridge.
    /// </summary>
    /// <param name="firstRender"><c>true</c> on the first render after the component mounts.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _selfRef = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("GKAdmin.registerDialogBridge", _selfRef);
        }
        catch (JSDisconnectedException)
        {
            // Circuit ended before registration completed; safe to ignore.
        }
    }

    /// <summary>
    /// Bridge entry point dispatched by the Plan 04 command palette via
    /// <c>window.GKAdmin.invokeDialog(commandId, targetId, targetName)</c>. Routes to the
    /// matching MudDialog with PlayerId + DisplayName parameters pre-populated. The dialog's
    /// existing CSRF + validation + audit-write paths run unchanged (Phase 03 contract).
    ///
    /// targetId is accepted as <c>string</c> rather than <c>Guid</c> so target-less actions
    /// (create-admin, rotate-signing-key, sign-out) can pass the literal Guid.Empty zero string
    /// without triggering JsonException on the JS-interop boundary (gap closure 03.1-10 fix
    /// for VERIFICATION BLOCKER-03).
    /// </summary>
    /// <param name="commandId">Stable command identifier from <c>AdminCommandRegistry</c>:
    ///   "ban", "unban", "gdpr-delete", "create-admin", "delete-admin", "rank-adjust",
    ///   "rotate-signing-key", "sign-out".</param>
    /// <param name="targetId">Player or admin GUID as a string. <c>Guid.Empty.ToString()</c>
    ///   ("00000000-0000-0000-0000-000000000000") for target-less actions; parsed via
    ///   <see cref="Guid.TryParse(string?, out Guid)"/> with <see cref="Guid.Empty"/> fallback
    ///   so malformed input never throws.</param>
    /// <param name="targetName">Display name for the dialog title.</param>
    [JSInvokable]
    public async Task OpenDialog(string commandId, string targetId, string targetName)
    {
        var pid = Guid.TryParse(targetId, out var parsed) ? parsed : Guid.Empty;

        // Build DialogParameters — most dialogs use PlayerId + DisplayName; end-season uses
        // LadderId + LadderName. We add the ladder-specific keys conditionally for "end-season"
        // so the dialog's [Parameter] LadderId is satisfied without polluting other dialogs.
        DialogParameters parameters;
        if (commandId == "end-season")
        {
            parameters = new DialogParameters
            {
                ["LadderId"] = pid,
                ["LadderName"] = targetName ?? string.Empty
            };
        }
        else
        {
            parameters = new DialogParameters
            {
                ["PlayerId"] = pid,
                ["DisplayName"] = targetName ?? string.Empty
            };
        }

        var dialogType = commandId switch
        {
            "ban"          => typeof(BanPlayerDialog),
            "unban"        => typeof(UnbanPlayerDialog),
            "gdpr-delete"  => typeof(GdprDeleteDialog),
            "create-admin" => typeof(CreateAdminDialog),
            "delete-admin" => typeof(DeleteAdminDialog),
            "end-season"   => typeof(EndSeasonDialog),
            "rank-adjust"  => typeof(RankAdjustDialog),
            // rotate-signing-key is Phase 6 territory.
            _ => null
        };
        if (dialogType is null) return;
        await Dialogs.ShowAsync(dialogType, $"{commandId}: {targetName}", parameters);
    }

    /// <summary>
    /// Releases the <see cref="DotNetObjectReference{MainLayout}"/> registered with
    /// <c>window.GKAdmin</c> so the GC can collect this layout instance once the circuit
    /// disposes. Called automatically by Blazor when the component is removed.
    /// </summary>
    public void Dispose() => _selfRef?.Dispose();
}
