@*
    UI-SPEC §Sidebar — 240px expanded / 64px collapsed rail of nav items.

    Order is authoritative: Dashboard → Players → Match history → Audit log → Health →
    Queue depth → Rank adjust (superadmin-only) → divider → Admins (superadmin-only).

    Superadmin-gated items wrap in <AuthorizeView Roles="@AdminRoles.Superadmin"> — this is
    defense-in-depth; the backend policy (plan 03-07 AdminPolicies.Superadmin) is the
    authoritative gate. UI hiding avoids showing operators controls they cannot exercise.

    Plan 03.1-08 — re-skinned: replaced <MudNavMenu>/<MudNavLink> with sketch's
    <nav class="sidebar"> + <a class="nav-item"> per primitives.jsx + shell.jsx.
    Active-link styling is route-aware via NavLink (Match=All for Dashboard so /admin
    only matches the dashboard exactly; Match=Prefix for sub-routes).
*@
<nav class="sidebar" aria-label="Admin sections">
    <NavLink href="/admin" Match="NavLinkMatch.All" class="nav-item" ActiveClass="nav-item active">
        <span class="label">Dashboard</span>
    </NavLink>
    <NavLink href="/admin/players" class="nav-item" ActiveClass="nav-item active">
        <span class="label">Players</span>
    </NavLink>
    <NavLink href="/admin/matches" class="nav-item" ActiveClass="nav-item active">
        <span class="label">Match history</span>
    </NavLink>
    <NavLink href="/admin/audit" class="nav-item" ActiveClass="nav-item active">
        <span class="label">Audit log</span>
    </NavLink>
    <NavLink href="/admin/health" class="nav-item" ActiveClass="nav-item active">
        <span class="label">Health</span>
    </NavLink>
    <NavLink href="/admin/matchmaking" class="nav-item" ActiveClass="nav-item active">
        <span class="label">Queue depth</span>
    </NavLink>
    <AuthorizeView Roles="@AdminRoles.Superadmin">
        <NavLink href="/admin/rankings/adjust" class="nav-item" ActiveClass="nav-item active">
            <span class="label">Rank adjust</span>
        </NavLink>
    </AuthorizeView>
    <div class="divider" role="separator" aria-orientation="horizontal"></div>
    <AuthorizeView Roles="@AdminRoles.Superadmin">
        <NavLink href="/admin/admins" class="nav-item" ActiveClass="nav-item active">
            <span class="label">Admins</span>
        </NavLink>
    </AuthorizeView>
</nav>
