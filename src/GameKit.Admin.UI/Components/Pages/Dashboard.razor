@*
    UI-SPEC §3 Dashboard — 12-column grid, 4 cards:
      Row 1: Health (span 6) + Queue depth (span 6)
      Row 2: Recent audit log (span 8) + Quick stats (span 4)

    RESEARCH Open Question 3: direct GameKitDbContext access (no extra HTTP hop). The
    component is server-rendered inside the circuit so the DbContext is safe to inject.

    Authentication: cookie-based [Authorize] with AdminPolicies.Admin — cookie events redirect
    unauthenticated hits to /admin/login.
*@
@page "/admin"
@attribute [Authorize(Policy = AdminPolicies.Admin)]
@using System.Threading
@using GameKit.Admin.UI.Entities
@using GameKit.Core.Data
@using GameKit.Core.Entities
@using Microsoft.EntityFrameworkCore
@inject GameKitDbContext Db
@inject IHealthProbeService HealthSvc
@inject IServiceProvider Sp

@* Plan 03.1-08 — direction-D 4-card grid (CONTEXT D-08; sketch dashboard.jsx).
   .grid-12 + .span-* sketch utilities replace MudGrid; .card / .card-head / .card-body
   replace MudPaper. The picker UI for directions A/B/C lives in TweaksPanel (Plan 05). *@
<div class="page-head">
    <h1>Dashboard</h1>
</div>

<div class="grid-12">
    @* Row 1 — Health (span 6) + Queue depth (span 6) *@
    <div class="card span-6">
        <div class="card-head">
            <h2>Health</h2>
            <a href="/admin/health" class="muted">View health panel</a>
        </div>
        <div class="card-body">
            @if (_health is null)
            {
                <div class="muted">Probing…</div>
            }
            else
            {
                <div class="kv">
                    <dt>Postgres</dt>
                    <dd><StatusChip Status="@_health.Postgres.Status" /></dd>
                    <dt>Redis</dt>
                    <dd><StatusChip Status="@_health.Redis.Status" /></dd>
                    <dt>Error rate</dt>
                    <dd><StatusChip Status="@_health.ErrorRate.Status" /></dd>
                </div>
            }
        </div>
    </div>

    <div class="card span-6">
        <div class="card-head"><h2>Queue depth</h2></div>
        <div class="card-body">
            @if (_matchmakingInstalled)
            {
                <div class="alert" role="status">
                    <div class="alert-body">Queue telemetry will render when GameKit.Matchmaking ships.</div>
                </div>
            }
            else
            {
                <MissingPackageAlert PackageName="Matchmaking" Feature="live queue telemetry" />
            }
        </div>
    </div>

    @* Row 2 — Recent audit log (span 8) + Quick stats (span 4) *@
    <div class="card span-8">
        <div class="card-head">
            <h2>Recent audit log</h2>
            <a href="/admin/audit" class="muted">View full audit log</a>
        </div>
        <div class="card-body flush">
            @if (_recentAudit is null)
            {
                <div class="muted" style="padding:16px;">Loading…</div>
            }
            else if (_recentAudit.Count == 0)
            {
                <div class="empty">
                    <h3>No admin actions recorded yet.</h3>
                    <p>Actions like bans, admin creates, and rank adjustments appear here.</p>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="t">
                        <thead>
                            <tr><th>Time</th><th>Actor</th><th>Action</th><th>Target</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _recentAudit)
                            {
                                <tr>
                                    <td class="mono">@row.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss") UTC</td>
                                    <td>@(row.ActorId?.ToString("N")[..8] ?? "system")</td>
                                    <td class="mono">@row.Action</td>
                                    <td class="mono">@(row.TargetId?.ToString("N")[..8] ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card span-4">
        <div class="card-head"><h2>Quick stats</h2></div>
        <div class="card-body">
            @if (_stats is null)
            {
                <div class="muted">Loading…</div>
            }
            else
            {
                <div class="metric">
                    <span class="lbl">Admins</span>
                    <span class="v">@_stats.AdminCount</span>
                </div>
                <div class="metric" style="margin-top:12px;">
                    <span class="lbl">Banned players</span>
                    <span class="v">@_stats.BannedCount</span>
                </div>
                <div class="metric" style="margin-top:12px;">
                    <span class="lbl">Sessions completed (24h)</span>
                    <span class="v">@_stats.SessionsCompletedToday</span>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private HealthReport? _health;
    private List<AdminAuditLog>? _recentAudit;
    private QuickStats? _stats;
    private bool _matchmakingInstalled;

    protected override async Task OnInitializedAsync()
    {
        var mmType = Type.GetType("GameKit.Matchmaking.Strategy.IMatchmakingStrategy, GameKit.Matchmaking", throwOnError: false);
        _matchmakingInstalled = mmType is not null && Sp.GetService(mmType) is not null;

        // Sequential await per query: EF Core forbids concurrent operations on a single
        // DbContext instance ("A second operation was started on this context instance before
        // a previous operation completed"). HealthSvc.ProbeAsync touches Postgres + Redis via
        // its own pooled clients so it's safe to run independently of Db, but the four EF
        // queries below all share the scoped DbContext and must serialize. The cost is a few
        // round-trips of latency on first paint — acceptable for an admin dashboard.
        var ct = CancellationToken.None;
        var healthTask = HealthSvc.ProbeAsync(ct);

        var recentAudit = await Db.AdminAuditLog.AsNoTracking()
            .OrderByDescending(r => r.CreatedAt).ThenByDescending(r => r.Id)
            .Take(5)
            .ToListAsync(ct);
        var adminCount = await Db.Set<AdminUser>().AsNoTracking().LongCountAsync(ct);
        var bannedCount = await Db.Players.AsNoTracking().LongCountAsync(p => p.IsBanned, ct);
        var since = DateTimeOffset.UtcNow.AddDays(-1);
        var sessionsCompleted = await Db.GameSessions.AsNoTracking()
            .LongCountAsync(s => s.State == GameSessionState.Completed && s.CompletedAt != null && s.CompletedAt >= since, ct);

        // Health probe runs on its own clients — await last so it overlaps with the EF queries.
        _health = await healthTask;
        _recentAudit = recentAudit;
        _stats = new QuickStats(adminCount, bannedCount, sessionsCompleted);
    }

    private sealed record QuickStats(long AdminCount, long BannedCount, long SessionsCompletedToday);
}
