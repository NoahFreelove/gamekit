@*
    UI-SPEC §10 Health panel — 3 status tiles (Postgres / Redis / Error rate) with refresh
    button + auto-refresh caption. Polls every GameKitAdminOptions.Panel.RefreshInterval
    via System.Threading.Timer; disposes via IAsyncDisposable so the timer stops when the
    circuit tears down.
*@
@page "/admin/health"
@attribute [Authorize(Policy = AdminPolicies.Admin)]
@implements IAsyncDisposable
@inject IHealthProbeService HealthSvc
@inject GameKitAdminOptions Options

@* Plan 03.1-08 — sketch class names: .page-head, .card, .grid-12 + .span-4. *@
<div class="page-head">
    <h1>Health</h1>
    <div class="actions">
        <span class="muted">Auto-refresh every @((int)Options.Panel.RefreshInterval.TotalSeconds)s</span>
        <button type="button" class="btn" @onclick="RefreshAsync" disabled="@_refreshing">
            @if (_refreshing) { <span>Refreshing…</span> } else { <span>Refresh</span> }
        </button>
    </div>
</div>

<div class="card">
    <div class="card-head"><h2>Status</h2></div>
    <div class="card-body">
        <div class="grid-12">
            <div class="span-4">
                <HealthTileView Tile="_report?.Postgres" Label="Postgres" CheckedAt="_report?.CheckedAt" />
            </div>
            <div class="span-4">
                <HealthTileView Tile="_report?.Redis" Label="Redis" CheckedAt="_report?.CheckedAt" />
            </div>
            <div class="span-4">
                <HealthTileView Tile="_report?.ErrorRate" Label="Error rate" CheckedAt="_report?.CheckedAt" />
            </div>
        </div>
    </div>
</div>

@code {
    private HealthReport? _report;
    private Timer? _timer;
    private bool _refreshing;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _timer = new Timer(
            _ => _ = InvokeAsync(RefreshAsync),
            null,
            Options.Panel.RefreshInterval,
            Options.Panel.RefreshInterval);
    }

    private async Task RefreshAsync()
    {
        if (_refreshing) return;
        _refreshing = true;
        try
        {
            _report = await HealthSvc.ProbeAsync(CancellationToken.None);
            StateHasChanged();
        }
        catch
        {
            // Keep the last-known report on failure; the refresh button remains available.
        }
        finally
        {
            _refreshing = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_timer is not null)
        {
            await _timer.DisposeAsync();
        }
    }
}
