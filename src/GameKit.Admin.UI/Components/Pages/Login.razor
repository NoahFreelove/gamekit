@*
    UI-SPEC §1 Admin login page — centered card on LoginLayout (no top nav, no sidebar).
    UI-SPEC §2 First-admin-missing state — dev/staging-only bootstrap hint rendered inside
    the same card when zero admins exist (CLI bootstrap via `dotnet gamekit admin create`).

    RENDERING MODEL — static SSR (deliberate, not legacy):
    The page is marked [ExcludeFromInteractiveRouting] so App.razor renders <Routes> with no
    rendermode for this request. The browser submits a real HTML form to POST /admin/login;
    AdminFormEndpoints.LoginFormAsync writes the auth cookie via HttpContext.SignInAsync and
    returns 302 → /admin (or the safe ReturnUrl). Because the BROWSER makes the POST, the
    Set-Cookie header lands in the browser cookie jar — which is impossible if the server's
    HttpClient makes the call from inside an interactive Blazor circuit. See the architecture
    note in AdminEndpoints.cs for the full rule.

    Copy (UI-SPEC §Copywriting Contract, verbatim):
      - Primary CTA: "Sign in"
      - Forgot link: "Forgot password? Contact a superadmin."
      - Invalid credentials: "Username or password is incorrect."
      - Rate-limit 429: "Too many login attempts. Try again in a minute."
      - Banned / disabled: "This account has been disabled. Contact a superadmin."
      - 5xx: "Sign in is unavailable right now. Retry in a moment."
      - Session-expired toast (arrival from returnUrl): "Your session expired. Sign in to continue."
*@
@page "/admin/login"
@layout LoginLayout
@attribute [ExcludeFromInteractiveRouting]
@using GameKit.Admin.UI.Services
@inject IHostEnvironment HostEnv
@inject IAdminUserService AdminUsers
@inject NavigationManager Nav

<div class="gk-login-form">
    <h1 class="gk-login-heading">GameKit Admin</h1>
    <p class="gk-login-subheading">Sign in to continue</p>

    @if (_showFirstAdminMissing && !HostEnv.IsProduction())
    {
        @* UI-SPEC §2 first-admin-missing state — replaces the form when zero admins exist. *@
        <div class="gk-first-admin-missing">
            <h2 class="gk-first-admin-heading">No admin configured yet</h2>
            <p class="gk-first-admin-body">
                No superadmin exists in this database. Bootstrap one from a terminal to sign in:
            </p>
            <pre class="gk-first-admin-code"><code>dotnet gamekit admin create</code></pre>
            <p class="gk-first-admin-footer">
                You'll be prompted for a username and password. The first admin is automatically promoted to superadmin.
            </p>
        </div>
    }
    else
    {
        @* Form submits to a distinct POST URL (/admin/login/submit) — the Blazor @page
           route at /admin/login matches all HTTP methods, so a POST to the same URL would
           ambiguity-fault the endpoint matcher. The submit handler lives in
           AdminFormEndpoints.LoginFormAsync. *@
        <form method="post" action="/admin/login/submit" class="gk-login-form-fields">
            @* Antiforgery token — UseAntiforgery middleware validates it on the POST. The
               <AntiforgeryToken /> component emits a hidden input named __RequestVerificationToken
               that pairs with the gk_admin_csrf cookie. *@
            <AntiforgeryToken />

            @if (_errorMessage is not null)
            {
                <div class="gk-login-error" role="alert" data-severity="@_errorSeverity">@_errorMessage</div>
            }

            <div class="gk-login-field">
                <label class="gk-login-label" for="gk-login-username">Username</label>
                <input id="gk-login-username"
                       name="Username"
                       type="text"
                       required
                       autocomplete="username"
                       autofocus
                       class="gk-login-input" />
            </div>

            <div class="gk-login-field">
                <label class="gk-login-label" for="gk-login-password">Password</label>
                <input id="gk-login-password"
                       name="Password"
                       type="password"
                       required
                       autocomplete="current-password"
                       class="gk-login-input" />
            </div>

            <label class="gk-login-checkbox">
                <input name="RememberMe" type="checkbox" value="true" />
                <span>Remember me for 30 days</span>
            </label>

            @if (!string.IsNullOrEmpty(_returnUrl))
            {
                <input type="hidden" name="ReturnUrl" value="@_returnUrl" />
            }

            <button type="submit" class="gk-login-button">Sign in</button>

            <p class="gk-login-forgot">Forgot password? Contact a superadmin.</p>
        </form>
    }
</div>

@code {
    private bool _showFirstAdminMissing;
    private string? _errorMessage;
    private string _errorSeverity = "error";
    private string? _returnUrl;

    protected override async Task OnInitializedAsync()
    {
        // Parse query string for inline error feedback (set by AdminFormEndpoints.LoginFormAsync
        // via 302 redirect after a failed submit) and the safe ReturnUrl to round-trip.
        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var error = query["error"];
        (_errorMessage, _errorSeverity) = error switch
        {
            "invalid"     => ("Username or password is incorrect.",                       "error"),
            "ratelimit"   => ("Too many login attempts. Try again in a minute.",          "warning"),
            "banned"      => ("This account has been disabled. Contact a superadmin.",    "error"),
            "unavailable" => ("Sign in is unavailable right now. Retry in a moment.",     "error"),
            _             => ((string?)null, "error"),
        };
        var rawReturn = query["ReturnUrl"];
        _returnUrl = !string.IsNullOrEmpty(rawReturn)
                     && rawReturn.StartsWith('/')
                     && !rawReturn.StartsWith("//", StringComparison.Ordinal)
            ? rawReturn
            : null;

        // D-05 dev/staging-only first-admin-missing state — production fails fast at startup
        // via SuperadminGateHostedService, so we never render this branch in prod regardless.
        if (!HostEnv.IsProduction())
        {
            try
            {
                var admins = await AdminUsers.ListAsync(CancellationToken.None);
                _showFirstAdminMissing = admins.Count == 0;
            }
            catch
            {
                // If the query fails (migration pending, DB unreachable) fall back to the form —
                // surface the real error on submit rather than blocking the entire page.
                _showFirstAdminMissing = false;
            }
        }
    }
}
