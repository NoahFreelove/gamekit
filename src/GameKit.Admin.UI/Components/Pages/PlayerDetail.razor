@*
    UI-SPEC §5 Player detail — header card with Ban/Unban + GDPR-Delete buttons (GDPR is
    superadmin-only) + MudTabs with 4 tabs: Identities / Credentials / Match history / Rank.

    Data loaded via direct GameKitDbContext access (server-rendered component). Mutations
    (Ban / Unban / GDPR delete) route through IDialogService → the three dialog components
    which POST to /admin/api/players/{id}/{ban|unban|gdpr-delete} with the CSRF header.
*@
@page "/admin/players/{Id:guid}"
@attribute [Authorize(Policy = AdminPolicies.Admin)]
@using GameKit.Core.Data
@using GameKit.Core.Entities
@using Microsoft.EntityFrameworkCore
@inject GameKitDbContext Db
@inject NavigationManager Nav
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IServiceProvider Sp

<h1 class="gk-page-heading">Player detail</h1>

@if (_loading)
{
    <MudSkeleton Height="120px" />
}
else if (_player is null)
{
    <MudAlert Severity="Severity.Warning" role="alert">
        Player @Id not found.
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => Nav.NavigateTo("/admin/players"))">
            Back to search
        </MudButton>
    </MudAlert>
}
else
{
    <MudPaper Class="@HeaderClass" Elevation="0">
        <div class="gk-player-header">
            <MudBreadcrumbs Items="_breadcrumbs" />
            <div class="gk-player-actions">
                @if (_player.IsBanned)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="OpenUnbanDialog">
                        Unban
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="OpenBanDialog">
                        Ban
                    </MudButton>
                }
                <AuthorizeView Roles="@AdminRoles.Superadmin">
                    <Authorized>
                        <MudTooltip Text="Permanent player deletion. Superadmin only." Arrow="true">
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="OpenGdprDialog">
                                Delete (GDPR)
                            </MudButton>
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>

        <div class="gk-player-meta">
            <span><strong>ID</strong> <span class="gk-mono">@_player.Id</span></span>
            <span><strong>Created</strong> <span class="gk-mono">@_player.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</span></span>
            <span><strong>Last seen</strong> <span class="gk-mono">@(_player.LastSeenAt?.UtcDateTime.ToString("yyyy-MM-dd HH:mm") ?? "—") UTC</span></span>
            <span><strong>Role</strong> Player</span>
        </div>

        @if (_player.IsBanned)
        {
            <div class="gk-player-banned-row">
                <StatusChip Status="Banned" />
                <MudText Typo="Typo.body2" Color="Color.Default">
                    Reason: @(_player.BanReason ?? "—")
                </MudText>
            </div>
        }
    </MudPaper>

    <MudTabs Elevation="0" Rounded="true" Class="gk-player-tabs">
        <MudTabPanel Text="Identities">
            @if (_identitiesEmpty)
            {
                <div class="gk-empty-state">
                    <MudText Typo="Typo.h6">No linked identities.</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Default">
                        This player has no external identity providers linked.
                    </MudText>
                </div>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Default">Identity listing will render when GameKit.Auth ships identity projections.</MudText>
            }
        </MudTabPanel>

        <MudTabPanel Text="Credentials">
            <div class="gk-empty-state">
                <MudText Typo="Typo.h6">No password credential set.</MudText>
                <MudText Typo="Typo.body2" Color="Color.Default">
                    This player has never set a password (guest or OAuth-only).
                </MudText>
            </div>
        </MudTabPanel>

        <MudTabPanel Text="Match history">
            @if (_matchHistory is null)
            {
                <MudSkeleton Height="120px" />
            }
            else if (_matchHistory.Count == 0)
            {
                <div class="gk-empty-state">
                    <MudText Typo="Typo.h6">No match history yet.</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Default">
                        This player hasn't completed any matches.
                    </MudText>
                </div>
            }
            else
            {
                <MudSimpleTable Dense="true" Hover="true">
                    <thead>
                        <tr><th>Session</th><th>Ladder</th><th>Result</th><th>Rating Δ</th><th>Completed</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in _matchHistory)
                        {
                            <tr>
                                <td class="gk-mono">@m.SessionId.ToString("N")[..8]…</td>
                                <td class="gk-mono">@(m.LadderId?.ToString("N")[..8] ?? "—")</td>
                                <td>@(m.Result?.ToString() ?? "—")</td>
                                <td class="gk-mono">@(m.RatingDelta?.ToString("+0.##;-0.##;0") ?? "—")</td>
                                <td class="gk-mono">@(m.CompletedAt?.UtcDateTime.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudTabPanel>

        <MudTabPanel Text="Rank">
            @if (_rankingsInstalled)
            {
                <MudText Typo="Typo.body2" Color="Color.Default">Rank listing will render when GameKit.Rankings ships.</MudText>
            }
            else
            {
                <MissingPackageAlert PackageName="Rankings" Feature="per-ladder rating history" />
            }
        </MudTabPanel>
    </MudTabs>
}

@code {
    /// <summary>Player id passed via the @page "/admin/players/{Id:guid}" route parameter.</summary>
    [Parameter] public Guid Id { get; set; }

    private Player? _player;
    private bool _loading = true;
    private bool _identitiesEmpty = true;
    private List<MatchRow>? _matchHistory;
    private bool _rankingsInstalled;
    private List<BreadcrumbItem> _breadcrumbs = new();

    /// <summary>Projection row for the Match history tab — joins SessionParticipant + GameSession.</summary>
    private sealed record MatchRow(
        Guid SessionId,
        Guid? LadderId,
        int Team,
        SessionResult? Result,
        double? RatingDelta,
        DateTimeOffset? CompletedAt);

    private string HeaderClass => _player?.IsBanned == true
        ? "gk-dashboard-card gk-player-header-card gk-banned"
        : "gk-dashboard-card gk-player-header-card";

    protected override async Task OnInitializedAsync()
    {
        var rankingsType = Type.GetType("GameKit.Rankings.IRankingAlgorithm, GameKit.Rankings", throwOnError: false);
        _rankingsInstalled = rankingsType is not null && Sp.GetService(rankingsType) is not null;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var ct = CancellationToken.None;
        _player = await Db.Players.AsNoTracking().FirstOrDefaultAsync(p => p.Id == Id, ct);
        if (_player is not null)
        {
            _breadcrumbs = new List<BreadcrumbItem>
            {
                new("Players", "/admin/players"),
                new(_player.DisplayName, href: null, disabled: true),
            };
            // Join SessionParticipant → GameSession manually — SessionParticipantConfiguration
            // defines the FK with no navigation property (Phase-1 decision for GDPR cascade
            // clarity; see 03-07 SUMMARY). Filters to Completed sessions only.
            _matchHistory = await (
                from p in Db.Set<SessionParticipant>().AsNoTracking()
                join s in Db.GameSessions.AsNoTracking() on p.SessionId equals s.Id
                where p.PlayerId == Id && s.State == GameSessionState.Completed
                orderby s.CompletedAt descending
                select new MatchRow(
                    p.SessionId,
                    s.LadderId,
                    p.Team,
                    p.Result,
                    p.RatingDelta,
                    s.CompletedAt))
                .Take(25)
                .ToListAsync(ct);
        }
        _loading = false;
        StateHasChanged();
    }

    private async Task OpenBanDialog()
    {
        if (_player is null) return;
        var parameters = new DialogParameters
        {
            ["PlayerId"] = _player.Id,
            ["DisplayName"] = _player.DisplayName,
        };
        var reference = await Dialogs.ShowAsync<Dialogs.BanPlayerDialog>($"Ban {_player.DisplayName}?", parameters);
        var result = await reference.Result;
        if (result is not null && !result.Canceled && result.Data is true)
        {
            Snackbar.Add($"Player {_player.DisplayName} banned.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenUnbanDialog()
    {
        if (_player is null) return;
        var parameters = new DialogParameters
        {
            ["PlayerId"] = _player.Id,
            ["DisplayName"] = _player.DisplayName,
        };
        var reference = await Dialogs.ShowAsync<Dialogs.UnbanPlayerDialog>($"Unban {_player.DisplayName}?", parameters);
        var result = await reference.Result;
        if (result is not null && !result.Canceled && result.Data is true)
        {
            Snackbar.Add($"Player {_player.DisplayName} unbanned.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenGdprDialog()
    {
        if (_player is null) return;
        var parameters = new DialogParameters
        {
            ["PlayerId"] = _player.Id,
            ["DisplayName"] = _player.DisplayName,
        };
        var reference = await Dialogs.ShowAsync<Dialogs.GdprDeleteDialog>($"Delete {_player.DisplayName} permanently?", parameters);
        var result = await reference.Result;
        if (result is not null && !result.Canceled && result.Data is true)
        {
            Snackbar.Add($"Player {_player.DisplayName} deleted. Audit log updated.", Severity.Success);
            Nav.NavigateTo("/admin/players");
        }
    }
}
