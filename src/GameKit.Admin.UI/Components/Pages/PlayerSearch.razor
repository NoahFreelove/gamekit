@*
    UI-SPEC §4 Player search — unified search box + MudDataGrid with 6 columns +
    keyset "Load more" button.

    Search input is debounced 250ms (CONTEXT D-12 + UI-SPEC §4). On row click → navigate
    to /admin/players/{id}. Banned rows get a 3px danger left-border (CSS hook).

    Reads go through IPlayerSearchService directly (server-rendered Blazor Server circuit;
    no extra HTTP hop needed).
*@
@page "/admin/players"
@attribute [Authorize(Policy = AdminPolicies.Admin)]
@implements IDisposable
@inject IPlayerSearchService SearchSvc
@inject NavigationManager Nav

<h1 class="gk-page-heading">Players</h1>

<MudPaper Class="gk-search-panel" Elevation="0">
    <MudTextField T="string"
                  @bind-Value="_query"
                  @bind-Value:after="OnQueryChanged"
                  Placeholder="Search by player id, display name, or provider:external_id"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true"
                  DebounceInterval="250"
                  Clearable="true"
                  Variant="Variant.Outlined"
                  FullWidth="true" />
    <MudText Typo="Typo.caption" Color="Color.Default" Class="gk-search-examples">
        Examples: 0196e1a2-… | alice | steam:76561198012345678
    </MudText>
</MudPaper>

@if (string.IsNullOrWhiteSpace(_query) && _rows.Count == 0 && !_loading)
{
    <div class="gk-empty-state">
        <MudText Typo="Typo.h5">Search for a player</MudText>
        <MudText Typo="Typo.body2" Color="Color.Default">
            Enter a player ID, display name, or provider:external_id above. Results appear here.
        </MudText>
    </div>
}
else if (_errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" role="alert">
        @_errorMessage
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="RetryAsync">Retry</MudButton>
    </MudAlert>
}
else if (_loading && _rows.Count == 0)
{
    @* First-page skeleton — 5 rows of 40px each (UI-SPEC §4 loading). *@
    @for (var i = 0; i < 5; i++)
    {
        <MudSkeleton Height="40px" Class="gk-grid-skeleton" />
    }
}
else if (_rows.Count == 0 && !string.IsNullOrWhiteSpace(_query))
{
    <div class="gk-empty-state">
        <MudText Typo="Typo.h5">No matches</MudText>
        <MudText Typo="Typo.body2" Color="Color.Default">
            No player matched "@_query". Try a different spelling, a provider:external_id lookup, or a UUID.
        </MudText>
    </div>
}
else
{
    <MudDataGrid T="PlayerRow"
                 Items="_rows"
                 Dense="true"
                 Hover="true"
                 Virtualize="false"
                 RowClick="OnRowClick"
                 RowClassFunc="@RowClass"
                 Class="gk-player-grid">
        <Columns>
            <PropertyColumn Property="x => x.Id" Title="Player ID">
                <CellTemplate>
                    <MudTooltip Text="@context.Item.Id.ToString()" Arrow="true">
                        <span class="gk-mono">@context.Item.Id.ToString("N")[..8]…</span>
                    </MudTooltip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.DisplayName" Title="Display name" />
            <TemplateColumn Title="Primary identity">
                <CellTemplate>
                    <span class="gk-mono">—</span>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.CreatedAt" Title="Created">
                <CellTemplate>
                    <span class="gk-mono">@context.Item.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</span>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="Status">
                <CellTemplate>
                    <StatusChip Status="@(context.Item.IsBanned ? "Banned" : "Active")" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Actions">
                <CellTemplate>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                               OnClick="@(() => NavigateToDetail(context.Item.Id))">View</MudButton>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>

    <KeysetPaginator HasMore="_hasMore" IsLoading="_loadingMore" PageSize="50" OnLoadMore="LoadMoreAsync" />
}

@code {
    private string _query = string.Empty;
    private readonly List<PlayerRow> _rows = new();
    private Guid? _afterId;
    private bool _hasMore;
    private bool _loading;
    private bool _loadingMore;
    private string? _errorMessage;
    private CancellationTokenSource? _cts;

    private async Task OnQueryChanged()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        _rows.Clear();
        _afterId = null;
        _errorMessage = null;
        if (string.IsNullOrWhiteSpace(_query))
        {
            _hasMore = false;
            StateHasChanged();
            return;
        }
        await FetchAsync(_cts.Token);
    }

    private async Task LoadMoreAsync()
    {
        _loadingMore = true;
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        try
        {
            await FetchAsync(_cts.Token, append: true);
        }
        finally
        {
            _loadingMore = false;
        }
    }

    private async Task RetryAsync()
    {
        _errorMessage = null;
        await FetchAsync(CancellationToken.None);
    }

    private async Task FetchAsync(CancellationToken ct, bool append = false)
    {
        if (!append) _loading = true;
        StateHasChanged();
        try
        {
            var page = await SearchSvc.SearchAsync(_query, append ? _afterId : null, 50, ct);
            if (!append) _rows.Clear();
            _rows.AddRange(page.Items);
            _hasMore = page.HasMore;
            _afterId = _rows.Count > 0 ? _rows[^1].Id : null;
        }
        catch (OperationCanceledException)
        {
            // Silently swallow — superseded by a newer query.
        }
        catch (Exception ex)
        {
            _errorMessage = $"Search failed: {ex.Message}. Try again.";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void OnRowClick(DataGridRowClickEventArgs<PlayerRow> args)
    {
        NavigateToDetail(args.Item.Id);
    }

    private void NavigateToDetail(Guid id) => Nav.NavigateTo($"/admin/players/{id}");

    private static string RowClass(PlayerRow row, int _index) =>
        row.IsBanned ? "gk-row-banned" : string.Empty;

    public void Dispose() => _cts?.Cancel();
}
