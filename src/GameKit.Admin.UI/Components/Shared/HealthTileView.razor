@*
    UI-SPEC §10 Health panel tile — Postgres / Redis / Error rate.
      Top row: label (left) + status chip (right)
      Big value: status text (.v)
      Detail row: latency / error count caption
      Footer: last-checked timestamp

    Plan 03.1-08 — re-skinned: replaced <MudPaper> with sketch's <div class="health-tile">
    (.health-tile / .top / .name / .v / .footer rules already ported from sketch styles.css
    in Plan 02). Status chip pulls from the re-skinned StatusChip component.
*@
<div class="health-tile">
    <div class="top">
        <span class="name">@Label</span>
        @if (Tile is not null)
        {
            <StatusChip Status="@Tile.Status" />
        }
    </div>
    @if (Tile is null)
    {
        <div class="v" aria-hidden="true">…</div>
    }
    else
    {
        <div class="v">@Tile.Status</div>
        <div class="muted">@Tile.Detail</div>
    }
    @if (CheckedAt.HasValue)
    {
        <div class="footer">
            <span class="mono">updated @CheckedAt.Value.UtcDateTime.ToString("HH:mm:ss") UTC</span>
        </div>
    }
</div>

@code {
    /// <summary>Tile payload returned by IHealthProbeService.ProbeAsync. Null while loading.</summary>
    [Parameter] public HealthTile? Tile { get; set; }

    /// <summary>Static label (Postgres / Redis / Error rate).</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    /// <summary>UTC timestamp at which the parent report was taken.</summary>
    [Parameter] public DateTimeOffset? CheckedAt { get; set; }
}
