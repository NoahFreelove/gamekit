@*
    UI-SPEC §Color semantic status table — status chip colors:
      OK / Active / Healthy / Online  → Success (green-600 / green-100 bg)
      Degraded                        → Warning (amber-600 / amber-100 bg)
      Down / Offline / Error / Banned → Danger  (red-600   / red-100  bg)
      (anything else)                 → Info    (blue-600  / blue-100 bg)

    role="status" + aria-label mirrors UI-SPEC §Interaction Contract accessibility rule
    ("Status chips: role=\"status\" + aria-label=\"{status text}\"").
*@
<MudChip T="string"
         Variant="Variant.Filled"
         Size="Size.Small"
         Color="@MapColor(Status)"
         Label="true"
         role="status"
         aria-label="@Status">
    @Status
</MudChip>

@code {
    /// <summary>The status text to display. Drives both the chip label and the color mapping.</summary>
    [Parameter, EditorRequired] public string Status { get; set; } = string.Empty;

    /// <summary>
    /// Maps a status string to a MudBlazor <see cref="Color"/> value per the UI-SPEC §Color
    /// semantic-status allowlist. Unknown values default to <c>Color.Info</c>.
    /// </summary>
    /// <param name="status">Status string (case-insensitive).</param>
    /// <returns>MudBlazor color enum.</returns>
    private static Color MapColor(string status) => status?.Trim().ToLowerInvariant() switch
    {
        "ok" or "active" or "healthy" or "online" or "up" => Color.Success,
        "degraded" or "warning" => Color.Warning,
        "down" or "offline" or "error" or "banned" => Color.Error,
        _ => Color.Info,
    };
}
