<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>GameKit.Auth.Apple</PackageId>
    <Description>Sign-In-with-Apple OAuth provider for GameKit — opt-in sibling package (Phase 7).</Description>
    <PackageTags>gamekit;auth;oauth;apple;apache-2.0</PackageTags>
    <RootNamespace>GameKit.Auth.Apple</RootNamespace>
    <AssemblyName>GameKit.Auth.Apple</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!--
      ASP.NET Core types (Authentication primitives, IApplicationBuilder) from the shared framework.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Needs IOAuthProvider + IGameKitBuilder + GameKitDbContext — depends on GameKit.Auth which
         transitively brings in GameKit.Core. No direct GameKit.Core reference needed. -->
    <ProjectReference Include="..\GameKit.Auth\GameKit.Auth.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Apple Sign-In handler — aspnet-contrib, same release train as Discord 10.0.0 already in v1.
         Provides GenerateClientSecret=true + UsePrivateKey ES256 JWT per-exchange.
         Version pinned centrally in Directory.Packages.props (07-02 CPM entry). -->
    <PackageReference Include="AspNet.Security.OAuth.Apple" />
    <!-- NO Microsoft.EntityFrameworkCore.Design — zero migrations in this package. -->
  </ItemGroup>
  <!-- D-15: GameKit.Build source-generator emits GameKitMarker.GameKitVersion + GameKitMarker.AssemblyName
       constants at compile time. Required by GameKitVersionAssertionHostedService (DIST-07/OPS-05). -->
  <ItemGroup>
    <ProjectReference Include="..\GameKit.Build\GameKit.Build.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
