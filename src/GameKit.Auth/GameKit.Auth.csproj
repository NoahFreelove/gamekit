<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>GameKit.Auth</PackageId>
    <Description>Authentication package for GameKit — Steam, Discord, guest, username/password providers with JWT issuance and refresh rotation. Phase 2 deliverable.</Description>
    <PackageTags>gamekit;auth;jwt;steam;discord;oauth;apache-2.0</PackageTags>
    <RootNamespace>GameKit.Auth</RootNamespace>
    <AssemblyName>GameKit.Auth</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!--
      ASP.NET Core types (Authentication primitives, IApplicationBuilder) from the shared framework.
      The JwtBearer handler ships as a separate NuGet package in .NET 10 (it was pulled out of the
      shared framework in .NET 8) — see PackageReference below.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameKit.Core\GameKit.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- EF Core + Postgres provider (versions pinned centrally in Directory.Packages.props) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />

    <!-- Named-HttpClient resilience pipelines (Polly v8 under the hood) for provider HTTP calls -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />

    <!-- Password hashing (AUTH-09) + JWT signing (AUTH-10) — plan 02-04 -->
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />

    <!-- OAuth providers (plan 02-05) + Scrutor-based IOAuthProvider discovery. NOTE: -->
    <!-- AspNet.Security.OpenId.Steam is intentionally NOT referenced (CONTEXT D-09 — -->
    <!-- GameKit ships an in-house SteamOpenIdVerifier). See Directory.Packages.props.  -->
    <PackageReference Include="AspNet.Security.OAuth.Discord" />
    <PackageReference Include="Scrutor" />

    <!-- HTTP request validation (plan 02-07). FluentValidation 12 + DI extensions for the   -->
    <!-- ValidationEndpointFilter<T> generic filter; no MVC auto-validation coupling.         -->
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />

    <!-- Optional Redis dependency for AccountMergeService post-commit cleanup (Plan 10-03).
         The IConnectionMultiplexer ctor parameter is nullable — Auth installs and runs without
         Redis; stale matchmaking keys TTL-expire naturally when no Redis is configured. -->
    <PackageReference Include="StackExchange.Redis" />

    <!-- Design-time EF Core tooling (dotnet ef migrations add/update) — not shipped in .nupkg -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <!-- D-15 + 06-PATTERNS Critical Misuse Warning #5: GameKit.Build emits
       internal GameKitMarker.GameKitVersion + GameKitMarker.AssemblyName
       consts at compile time. OutputItemType=Analyzer routes the
       generator through Roslyn; ReferenceOutputAssembly=false stops the
       build-tooling DLL from becoming a runtime dependency. -->
  <ItemGroup>
    <ProjectReference Include="..\GameKit.Build\GameKit.Build.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
