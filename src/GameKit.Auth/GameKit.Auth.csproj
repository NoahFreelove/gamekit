<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>GameKit.Auth</PackageId>
    <Description>Authentication package for GameKit — Steam, Discord, guest, username/password providers with JWT issuance and refresh rotation. Phase 2 deliverable.</Description>
    <PackageTags>gamekit;auth;jwt;steam;discord;oauth;gpl</PackageTags>
    <RootNamespace>GameKit.Auth</RootNamespace>
    <AssemblyName>GameKit.Auth</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameKit.Core\GameKit.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- EF Core + Postgres provider (versions pinned centrally in Directory.Packages.props) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />

    <!-- Design-time EF Core tooling (dotnet ef migrations add/update) — not shipped in .nupkg -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
