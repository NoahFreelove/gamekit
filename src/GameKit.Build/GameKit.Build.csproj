<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      MANDATORY: Roslyn source generators MUST target netstandard2.0.
      The generator assembly is loaded by the C# compiler host, which
      itself runs on netstandard2.0. Targeting net10.0 here would surface
      "Generator 'GameKitVersionGenerator' failed to initialize" at every
      consumer build. (06-RESEARCH §Anti-patterns lines 873-874;
      06-PATTERNS Critical Misuse Warning #3.)
    -->
    <TargetFramework>netstandard2.0</TargetFramework>

    <!-- Identifies this as a Roslyn analyzer/source-generator component
         for tooling (Visual Studio analyzer load, dotnet pack analyzer
         layout). -->
    <IsRoslynComponent>true</IsRoslynComponent>

    <!-- Enforces analyzer-specific rules: no ConditionalWeakTable, no
         System.IO, no banned APIs. Catches incidental dependencies that
         would fail at compiler load time. -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <!--
      Opt OUT of repo-wide Central Package Management. The analyzer
      compiler-API version is tightly coupled to the IIncrementalGenerator
      contract emitted; the pin lives inline below so the CPM pin set
      cannot accidentally bump it without intent. (D-25 / OQ3;
      06-PATTERNS Critical Misuse Warning #4.)
    -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <!-- This project is BUILD TOOLING, NOT a shipped runtime package.
         Belt + suspenders: IsPackable=false stops `dotnet pack` from
         producing a .nupkg at all; IncludeBuildOutput=false stops the
         DLL from being placed in lib/ if Pack is ever forced. -->
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <!-- Override the repo-root <GenerateDocumentationFile>true</> default:
         the generator code is internal + the emitted .g.cs carries an
         <auto-generated/> first-line preamble. Public XML doc comments
         are not warranted; CS1591 would fire spuriously otherwise.
         (06-RESEARCH line 906.) -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GameKit.Build</RootNamespace>
    <AssemblyName>GameKit.Build</AssemblyName>

    <!-- Override repo-root ImplicitUsings inherited from .NET 10 SDK:
         this project targets netstandard2.0 where the implicit using
         set doesn't apply. Explicit `using` statements throughout. -->
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Microsoft.CodeAnalysis.CSharp 4.13.0: conservative lowest version
      that supports IIncrementalGenerator on the .NET 10 SDK's Roslyn
      bundle. PrivateAssets=all stops this from flowing to any consumer.
      Inline pin (NOT in Directory.Packages.props) because
      ManagePackageVersionsCentrally=false above.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
