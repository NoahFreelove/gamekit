<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackageId>GameKit.Cli</PackageId>
    <Description>GameKit CLI — 'gamekit migrate' and (stub) 'gamekit admin create'. Installed as a dotnet tool.</Description>
    <PackageTags>gamekit;dotnet-tool;migrations;cli</PackageTags>
    <RootNamespace>GameKit.Cli</RootNamespace>
    <AssemblyName>gamekit</AssemblyName>

    <!-- Dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>gamekit</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameKit.Core\GameKit.Core.csproj" />
    <!-- Plan 03-11: GameKit.Admin.UI brings AdminUser (public) + AdminModelBuilderExtension
         (internal, reachable via InternalsVisibleTo("GameKit.Cli") on GameKit.Admin.UI).
         Transitive Blazor build-time cost is accepted; runtime cost is zero because the
         CLI never mounts Blazor. -->
    <ProjectReference Include="..\GameKit.Admin.UI\GameKit.Admin.UI.csproj" />
    <!-- Plan 04-04: GameKit.Rankings brings ServiceToken entities + RankingsMigrationModelCustomizer
         (internal, reachable via InternalsVisibleTo("GameKit.Cli") on GameKit.Rankings). -->
    <ProjectReference Include="..\GameKit.Rankings\GameKit.Rankings.csproj" />
    <!-- Plan 17-03: GameKit.Auth, GameKit.Matchmaking, and GameKit.Lobby are required so the
         CLI can build per-package migration DbContexts for migrations list (DR-04)
         and migrations apply dry-run (DR-05). All three MigrationModelCustomizers
         are public sealed so no InternalsVisibleTo grant is needed. -->
    <ProjectReference Include="..\GameKit.Auth\GameKit.Auth.csproj" />
    <ProjectReference Include="..\GameKit.Matchmaking\GameKit.Matchmaking.csproj" />
    <ProjectReference Include="..\GameKit.Lobby\GameKit.Lobby.csproj" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>
</Project>
