<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>GameKit.Core</PackageId>
    <Description>Core entities, DbContext infrastructure, fluent builder, and GDPR service for the GameKit self-hostable game-services library. Every sibling package depends on this.</Description>
    <PackageTags>gamekit;game-services;ef-core;postgres;self-hosted;gpl</PackageTags>

    <RootNamespace>GameKit.Core</RootNamespace>
    <AssemblyName>GameKit.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core types (HttpContext, minimal APIs, RateLimiting) from shared framework — zero extra .nupkg weight -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core + Postgres provider (versions pinned centrally in Directory.Packages.props) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />

    <!-- Design-time EF Core tooling (dotnet ef migrations add/update) — not shipped in .nupkg -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- DI scanning for IModelBuilderExtension / sibling strategies -->
    <PackageReference Include="Scrutor" />
  </ItemGroup>

</Project>
