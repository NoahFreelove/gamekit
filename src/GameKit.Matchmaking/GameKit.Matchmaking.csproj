<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>GameKit.Matchmaking</PackageId>
    <Description>Matchmaking package for GameKit — Redis-backed queue, party-aware strategy, leader election. Phase 5 deliverable.</Description>
    <PackageTags>gamekit;matchmaking;redis;queue;gpl</PackageTags>
    <RootNamespace>GameKit.Matchmaking</RootNamespace>
    <AssemblyName>GameKit.Matchmaking</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameKit.Core\GameKit.Core.csproj" />
    <!-- Intentional coupling per RESEARCH §Decision 17 / OQ-3-RESOLVED: the default
         EloRangeMatchmakingStrategy reads player_ranks.rating via the shared
         GameKitDbContext, and the test-side MatchmakingTestModelCustomizer applies BOTH
         MatchmakingModelBuilderExtension and RankingsModelBuilderExtension. Verified no
         circular ref — Rankings has no ProjectReference back to Matchmaking. -->
    <ProjectReference Include="..\GameKit.Rankings\GameKit.Rankings.csproj" />
    <!-- Auth + Admin.UI ProjectReferences are design-time-boundary-only: the
         MatchmakingMigrationModelCustomizer enumerates every prior-package entity type
         (Player/GameSession/... in Core, PlayerIdentity/... in Auth, AdminUser in Admin,
         Ladder/... in Rankings) so a future entity addition in any prior package forces
         a CS0246 here — surfacing the per-package migration boundary explicitly at
         compile time (Plan 05-02 Task 2 must_haves.truths line 49). Runtime: Matchmaking
         services do NOT call into Auth or Admin.UI APIs — these references are scoped
         to typeof() in the exclusion list. -->
    <ProjectReference Include="..\GameKit.Auth\GameKit.Auth.csproj" />
    <ProjectReference Include="..\GameKit.Admin.UI\GameKit.Admin.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ASP.NET Core framework reference (IApplicationBuilder, IEndpointRouteBuilder,
         IHostedService) — supplied by Microsoft.AspNetCore.App shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />

    <!-- EF Core + Postgres provider (versions pinned centrally in Directory.Packages.props).
         Required so `dotnet ef migrations add` can locate the design-time tooling and the
         Npgsql migration generator. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql" />

    <!-- Design-time EF Core tooling (dotnet ef migrations add/update) — not shipped in .nupkg. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Runtime deps (versions pinned centrally in Directory.Packages.props):
         - Polly v8: SerializationFailureRetry pipeline retries Postgres 40001 in
           PartyService (Plan 05-04 SERIALIZABLE) and gates the analytics drain
           backoff (Plan 05-07 D-16).
         - StackExchange.Redis: AtomicClaimScript.ExecuteAsync evaluates the Lua
           atomic-claim script (Plan 05-04, RESEARCH §Decision 3) and powers the
           leader-gating helper IMatchmakerLease / RedisMatchmakerLease (Plan 05-07).
         - FluentValidation: HTTP request DTO validation (Plan 05-08 — JoinPartyRequest,
           EnqueueRequest, CreatePartyRequest validators consumed by ValidationEndpointFilter).
         - FluentValidation.DependencyInjectionExtensions: AddValidatorsFromAssemblyContaining
           registration helper in MatchmakingBuilderExtensions.Http.cs. -->
    <PackageReference Include="Polly" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>
</Project>
