<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>GameKit.OpenApi</PackageId>
    <Description>OpenAPI document generation for GameKit. Single combined /openapi/v1.json doc covering every player-facing GameKit HTTP endpoint (auth, sessions, matchmaking, parties, presence). Phase 6 deliverable.</Description>
    <PackageTags>gamekit;openapi;swagger;gpl</PackageTags>
    <RootNamespace>GameKit.OpenApi</RootNamespace>
    <AssemblyName>GameKit.OpenApi</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core ProjectRef — every shipped GameKit package depends on Core. -->
    <ProjectReference Include="..\GameKit.Core\GameKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core types — IAuthenticationSchemeProvider + JwtBearerDefaults
         + the broader runtime live in Microsoft.AspNetCore.App. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />

    <!-- Plan 06-06: Microsoft.AspNetCore.OpenApi 10.0.8 ships separately
         from Microsoft.AspNetCore.App shared framework (D-22; CPM-pinned
         in Directory.Packages.props by Plan 06-01). Provides
         OpenApiOptions / IOpenApiDocumentTransformer /
         OpenApiDocumentTransformerContext + AddOpenApi / MapOpenApi. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <!-- D-15 + 06-PATTERNS Critical Misuse Warning #5: every shipped
       GameKit src package consumes the GameKit.Build Roslyn source
       generator via OutputItemType=Analyzer + ReferenceOutputAssembly=false.
       The generator emits internal GameKitMarker.GameKitVersion +
       GameKitMarker.AssemblyName consts at compile time; the build-tooling
       DLL is NOT a runtime dependency of this package. -->
  <ItemGroup>
    <ProjectReference Include="..\GameKit.Build\GameKit.Build.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- docfx's metadata pass can't load the GameKit.Build source generator, so
       Directory.Build.targets drops the analyzer for that pass (DocFxMetadata=true) and
       GameKit.OpenApi.Internal.GameKitMarker is never generated — which would break
       GameKitInfoTransformer with CS0234. GameKit.OpenApi is the only project that uses
       that generated symbol in hand-written source, so compile a stub GameKitMarker for
       docfx only. The stub is auto-included by the SDK glob, so Remove it unconditionally
       first; real builds keep the generator's GameKitMarker and never the stub. -->
  <ItemGroup>
    <Compile Remove="GameKitMarker.DocFxStub.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(DocFxMetadata)' == 'true'">
    <Compile Include="GameKitMarker.DocFxStub.cs" />
  </ItemGroup>
</Project>
