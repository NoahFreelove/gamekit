<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>GameKit.Presence</PackageId>
    <Description>Presence package for GameKit — Redis TTL-keyed heartbeat, online/offline/in-match status. Phase 6 deliverable.</Description>
    <PackageTags>gamekit;presence;redis;heartbeat;gpl</PackageTags>
    <RootNamespace>GameKit.Presence</RootNamespace>
    <AssemblyName>GameKit.Presence</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameKit.Core\GameKit.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ASP.NET Core framework reference: required for HttpContext, IEndpointRouteBuilder,
         IApplicationBuilder, RequireAuthorization, Results.NoContent — used by the heartbeat
         endpoint (Plan 06-04 Task 3) and the AddPresence/MapPresence builder extensions.
         Supplied by the Microsoft.AspNetCore.App shared framework (NU1510 precedent —
         same pattern as src/GameKit.Matchmaking/GameKit.Matchmaking.csproj). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />

    <!-- StackExchange.Redis: presence storage backend. Single Redis key per player
         (presence:{playerId}) with TTL refresh + atomic Lua script for in-match precedence
         (PATTERNS warning #6 / RESEARCH Pattern 1 §CRITICAL precedence rule). Version pinned
         centrally via Directory.Packages.props (2.8.41 — repo-wide pin from Phase 1). -->
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>
  <!-- D-15 + 06-PATTERNS Critical Misuse Warning #5: GameKit.Build emits
       internal GameKitMarker.GameKitVersion + GameKitMarker.AssemblyName
       consts at compile time. OutputItemType=Analyzer routes the
       generator through Roslyn; ReferenceOutputAssembly=false stops the
       build-tooling DLL from becoming a runtime dependency. -->
  <ItemGroup>
    <ProjectReference Include="..\GameKit.Build\GameKit.Build.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
