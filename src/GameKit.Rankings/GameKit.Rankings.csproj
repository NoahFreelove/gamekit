<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>GameKit.Rankings</PackageId>
    <Description>Rankings package for GameKit — windowed Glicko-2 default, seasonal reset, session-complete idempotency. Phase 4 deliverable.</Description>
    <PackageTags>gamekit;rankings;glicko2;elo;leaderboard;gpl</PackageTags>
    <RootNamespace>GameKit.Rankings</RootNamespace>
    <AssemblyName>GameKit.Rankings</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameKit.Core\GameKit.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ASP.NET Core framework reference (AuthenticationHandler, IApplicationBuilder, IEndpointRouteBuilder) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />

    <!-- EF Core + Postgres provider (versions pinned centrally in Directory.Packages.props) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />

    <!-- Hosting abstractions for IHostedService supplied by the framework reference above -->

    <!-- Design-time EF Core tooling (dotnet ef migrations add/update) — not shipped in .nupkg -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- FluentValidation for SessionCompleteRequestValidator (plan 04-05) -->
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />

    <!-- Redis client for RankingsTickerLeaseHelper leader election (plan 04-06, D-03) -->
    <PackageReference Include="StackExchange.Redis" />

    <!-- Polly v8 for RankingsTickerLeaseHelper resilience pipeline (plan 04-06, D-03) -->
    <PackageReference Include="Polly" />
  </ItemGroup>
</Project>
