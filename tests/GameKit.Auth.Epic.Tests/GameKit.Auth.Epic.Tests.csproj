<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>GameKit.Auth.Epic.Tests</RootNamespace>
    <AssemblyName>GameKit.Auth.Epic.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Suppress CS1591 (missing XML docs) for test code; WarningsAsErrors clears the
         inherited CS1591 error from Directory.Build.props for this test project only. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <WarningsAsErrors />
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Moq" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <!-- WireMock.Net stubs the Epic token endpoint for the Basic-auth wire-format test
         (AUTH-21: EpicOAuthHandler.ExchangeCodeAsync uses Authorization: Basic header).
         Version pinned centrally in Directory.Packages.props (already present). -->
    <PackageReference Include="WireMock.Net" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GameKit.Auth.Epic\GameKit.Auth.Epic.csproj" />
    <ProjectReference Include="..\..\src\GameKit.Auth\GameKit.Auth.csproj" />
    <ProjectReference Include="..\GameKit.TestFixtures\GameKit.TestFixtures.csproj" />
  </ItemGroup>
</Project>
