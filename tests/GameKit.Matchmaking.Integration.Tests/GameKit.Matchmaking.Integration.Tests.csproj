<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>GameKit.Matchmaking.Integration.Tests</RootNamespace>
    <AssemblyName>GameKit.Matchmaking.Integration.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <WarningsAsErrors />
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Microsoft.Extensions.Hosting intentionally omitted: supplied by the
         Microsoft.AspNetCore.App framework reference above (Phase 1 NU1510
         precedent — same pattern as GameKit.Auth.Integration.Tests). -->
    <PackageReference Include="Moq" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GameKit.Matchmaking\GameKit.Matchmaking.csproj" />
    <ProjectReference Include="..\..\src\GameKit.Core\GameKit.Core.csproj" />
    <ProjectReference Include="..\..\src\GameKit.Rankings\GameKit.Rankings.csproj" />
    <!-- Auth + Admin.UI ProjectReferences required by MatchmakingAdvisoryLockKeyTests
         (asserts pairwise distinctness against AuthMigrationConstants.AdvisoryLockKey and
         AdminMigrationConstants.AdvisoryLockKey) — mirrors the Rankings.Integration.Tests
         csproj which has the same three ProjectReferences. -->
    <ProjectReference Include="..\..\src\GameKit.Auth\GameKit.Auth.csproj" />
    <ProjectReference Include="..\..\src\GameKit.Admin.UI\GameKit.Admin.UI.csproj" />
    <ProjectReference Include="..\GameKit.TestFixtures\GameKit.TestFixtures.csproj" />
  </ItemGroup>
</Project>
