<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>GameKit.Presence.Integration.Tests</RootNamespace>
    <AssemblyName>GameKit.Presence.Integration.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <WarningsAsErrors />
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Microsoft.Extensions.Hosting intentionally omitted: supplied by the
         Microsoft.AspNetCore.App framework reference above (Phase 1 NU1510
         precedent — same pattern as GameKit.Auth.Integration.Tests). -->
    <PackageReference Include="Moq" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
  </ItemGroup>
  <ItemGroup>
    <!-- Auth ProjectRef required for the JWT bearer scheme on the heartbeat
         integration test (Plan 06-04 / 06-05). Presence runtime does NOT depend
         on Rankings, Matchmaking, or Admin.UI (PATTERNS Block 12 line 925).
         The Rankings ProjectReference below is a TEST-ONLY coupling for the
         end-to-end SessionsLifecycleObserverTests in Plan 06-05 — the test
         needs the service-token auth handler and ladder seeding helpers that
         live in GameKit.Rankings. Runtime package boundary is unchanged. -->
    <ProjectReference Include="..\..\src\GameKit.Presence\GameKit.Presence.csproj" />
    <ProjectReference Include="..\..\src\GameKit.Core\GameKit.Core.csproj" />
    <ProjectReference Include="..\..\src\GameKit.Auth\GameKit.Auth.csproj" />
    <ProjectReference Include="..\..\src\GameKit.Rankings\GameKit.Rankings.csproj" />
    <ProjectReference Include="..\GameKit.TestFixtures\GameKit.TestFixtures.csproj" />
  </ItemGroup>
</Project>
